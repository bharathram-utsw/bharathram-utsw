---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Gallery" description="Photos from the Mondal Lab at UT Southwestern.">
  <div class="container gallery-page">
    <SectionHeading eyebrow="Around the lab" level="h1">Gallery</SectionHeading>
    <p class="prose gallery-page__lede reveal">Photos from the lab, conferences, and events.</p>

    <div class="gallery-page__grid reveal">
      {
        photos.map((photo, i) => (
          <figure class="gallery-tile corner-frame" data-placeholder={photo.data.placeholder}>
            <span class="mono gallery-tile__index" aria-hidden="true">{String(i + 1).padStart(3, '0')}</span>
            {photo.data.image ? (
              <img src={photo.data.image} alt={photo.data.alt} loading="lazy" />
            ) : (
              <div class="gallery-tile__placeholder" role="img" aria-label={photo.data.alt} />
            )}
            <figcaption class="mono gallery-tile__caption">{photo.data.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .gallery-page {
    padding-block: var(--space-6);
  }

  .gallery-page__lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .gallery-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .gallery-tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-raised);
  }

  .gallery-tile__index {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 1;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-bg);
    background: var(--color-text);
    padding: 0.15em 0.45em;
  }

  .gallery-tile img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gallery-tile__placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-text);
  }

  .gallery-tile__caption {
    padding: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-top: 1px solid var(--color-border);
  }
</style>
