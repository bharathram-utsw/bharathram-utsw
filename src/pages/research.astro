---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ThemeGlyph from '../components/ThemeGlyph.astro';
import { withBase } from '../lib/url';

// Text and framing verbatim from mondal-lab.com/research — this page
// mirrors the lab's own description of its two research programs rather
// than a paraphrase of it.
const processes = [
  {
    title: 'Assembling the Retinal Diseasome',
    glyphSeed: 0,
    body: "Retinal degenerative diseases and underlying causes are diverse. Genetic factors play significant roles in inherited retinal degenerations (IRD) as well as complex diseases such as age-related macular degenerations. Despite fixed-at-birth genetic makeup, pathological manifestations in the retina are age dependent. This leads to our hypothesis that in the pre-disease retina, unrelated genetic mutations converge to a finite set of disease onset programs. We aim to capture this framework in a retinal diseasome (a concept inspired by the human diseasome). Through multi-omic studies in disease models, the retinal diseasome will capture genetic factors, disease processes, and counteracting pathways that attempt to restore homeostasis.",
    image: '/images/retinal-diseasome-diagram.png',
    imageAlt:
      'Diagram tracing retinal neurodegeneration (RP, LCA, AMD) through disease genes to affected photoreceptor and other retinal cells to retinal cell death and vision loss, integrated into a retinal diseasome network; below, time series, multi-omic, network, and machine learning data layers feeding an IRD gene network',
  },
  {
    title: 'Uncovering Molecular Links Between Retinal Gene Regulation and the Environment',
    glyphSeed: 1,
    body: 'Aging is associated with declining visual acuity and is the primary risk factor for age-related neurodegenerative diseases. Spontaneous epigenetic alterations are known drivers of cellular aging and have been demonstrated in the retina. Environmental factors such as diet and nutrition modulate aging-retinal health and are risk factors in age-related diseases. Short- and long-term experiments in murine cohorts can model influence of independent environmental factors (eg. diet and nutrition) on retinal aging. We investigate how lifestyle choices, such as nutrition, influence retinal molecular landscapes and especially the Epigenome-Metabolism nexus.',
    image: '/images/epigenome-metabolism-diagram.png',
    imageAlt:
      'Diagram showing retinal transcriptome, epigenome, and metabolome data, plus other organs, feeding an integrative analysis that resolves a gene regulatory network at the intersection of aging, diet, and the epigenome-metabolism nexus',
  },
];
---

<BaseLayout
  title="Research"
  description="The Mondal Lab studies retinal diseasome assembly and environmental-molecular interactions in retinal aging, combining genomics, epigenomics, metabolism, and network analysis."
>
  <div class="container research-page">
    <SectionHeading level="h1">Research</SectionHeading>
    <p class="prose research-page__lede reveal">
      Two convergent research programs, one question: why do so many different causes — genetic,
      metabolic, environmental — end up producing the same handful of disease outcomes in the
      retina?
    </p>

    <div class="process-list reveal">
      {
        processes.map((p) => (
          <div class="widget process">
            <div class="process__row">
              <div class="process__body">
                <div class="process__head">
                  <ThemeGlyph class="process__glyph" seed={p.glyphSeed} />
                  <h2 class="process__title">{p.title}</h2>
                </div>
                <p class="prose process__text">{p.body}</p>
              </div>
              <figure class="process__figure">
                <img src={withBase(p.image)} alt={p.imageAlt} loading="lazy" />
              </figure>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .research-page {
    padding-block: var(--space-6);
  }

  .research-page__lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 56ch;
    margin-bottom: var(--space-4);
  }

  .process-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .process__row {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .process__body {
    flex: 1 1 26rem;
    min-width: 0;
  }

  .process__figure {
    flex: 0 0 26rem;
  }

  .process__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .process__glyph {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
  }

  .process__title {
    font-size: var(--text-xl);
  }

  .process__text {
    color: var(--color-text-muted);
  }

  .process__figure img {
    width: 100%;
    height: 100%;
    max-height: 26rem;
    object-fit: contain;
  }

  /* These are raster diagrams with a white background and black text
     baked in — they can't follow the theme tokens on their own. Inverting
     lightness (then rotating hue back) keeps the diagram's own colors
     roughly recognizable while flipping white-with-black-text to
     dark-with-light-text, so it actually sits inside a dark page instead
     of staying a bright rectangle regardless of theme. */
  :root[data-theme='night'] .process__figure img {
    filter: invert(1) hue-rotate(180deg);
  }

  @media (max-width: 860px) {
    .process__row {
      flex-direction: column;
    }

    .process__figure {
      flex: 0 0 auto;
      width: 100%;
      order: -1;
    }

    .process__figure img {
      max-height: 20rem;
    }
  }
</style>
