---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactBlock from '../components/ContactBlock.astro';
---

<BaseLayout title="Contact" description="Contact the Mondal Lab at UT Southwestern Medical Center.">
  <div class="container contact-page">
    <SectionHeading eyebrow="Get in touch" level="h1">Contact</SectionHeading>
    <div class="reveal">
      <ContactBlock />
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-block: var(--space-6);
  }
</style>
