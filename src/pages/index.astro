---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkHero from '../components/NetworkHero.astro';
import FiguresGrid from '../components/FiguresGrid.astro';
import { isVisionEra } from '../lib/publications';

const publications = await getCollection('publications');

const visionPubs = publications.filter((p) => isVisionEra(p.data.keywords));
const keywordCounts = new Map<string, number>();
for (const pub of visionPubs) {
  for (const kw of pub.data.keywords) {
    keywordCounts.set(kw, (keywordCounts.get(kw) ?? 0) + 1);
  }
}
const topTopics = [...keywordCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([label]) => label);
---

<BaseLayout title="Mondal Lab">
  <div class="container home">
    <div class="home__hero reveal">
      <div class="home__intro">
        <h1>Mondal Lab</h1>
        <p class="prose home__mission">
          We combine computational biology — genomics, epigenomics, metabolism, and network analysis —
          to discover mechanisms that maintain healthy vision and identify the earliest molecular
          patterns linked with blindness.
        </p>
        <p class="mono home__affiliation">
          UT Southwestern Medical Center · Department of Ophthalmology · Dallas, TX
        </p>
      </div>

      <div id="publications" class="home__hero-graph">
        <NetworkHero />
      </div>
    </div>

    <div class="widget home__topics reveal">
      <p class="widget__label">Topics</p>
      <div class="widget__tags">
        {topTopics.map((kw) => <span class="mono widget__tag">{kw}</span>)}
      </div>
    </div>

    <FiguresGrid class="home__figures reveal" />
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-5) var(--space-7);
  }

  .home__hero {
    display: grid;
    grid-template-columns: minmax(320px, 1fr) minmax(280px, 1fr);
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .home__hero-graph {
    height: 100%;
  }

  .home__intro h1 {
    font-size: var(--text-4xl);
  }

  .home__mission {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .home__affiliation {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  /* FiguresGrid is a child component — its outer wrapper only ever
     carries FiguresGrid's own scope attribute, not this page's, even for
     a class passed in as a prop, so this needs :global(). */
  :global(.home__figures) {
    margin-top: var(--space-3);
  }

  .widget__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }

  .widget__tag {
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    padding: 0.2em 0.55em;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .home__hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .home__intro h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
