---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkHero from '../components/NetworkHero.astro';
import ThemeGlyph from '../components/ThemeGlyph.astro';
import Avatar from '../components/Avatar.astro';
import { withBase } from '../lib/url';

const latestNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const publications = await getCollection('publications');
const team = await getCollection('team');
const pi = team.find((m) => m.data.isPI) ?? team[0];
---

<BaseLayout title="Mondal Lab">
  <NetworkHero>
    <h1 class="network-hero__title">Mondal Lab</h1>
    <p class="prose network-hero__mission">
      We combine computational biology — genomics, epigenomics, metabolism, and network analysis —
      to discover mechanisms that maintain healthy vision and identify the earliest molecular
      patterns linked with blindness.
    </p>
    <p class="mono network-hero__affiliation">
      UT Southwestern Medical Center · Department of Ophthalmology · Dallas, TX
    </p>
  </NetworkHero>

  <section class="home-statement section-ink reveal">
    <div class="container home-statement__inner">
      <span class="eyebrow">Why computational biology</span>
      <p class="home-statement__quote">
        More than 300 genes are already linked to inherited retinal disease, and complex
        conditions like age-related macular degeneration add hundreds more contributing factors
        on top. No single experiment can test that many variables at once — it takes
        computational methods to integrate genomic, epigenomic, and metabolic data across many
        studies and find the patterns a wet lab alone would miss.
      </p>
      <dl class="home-statement__stats">
        <div>
          <dt class="home-statement__stat-num">2</dt>
          <dd class="mono">Research programs</dd>
        </div>
        <div>
          <dt class="home-statement__stat-num">{publications.length}</dt>
          <dd class="mono">Publications</dd>
        </div>
        <div>
          <dt class="home-statement__stat-num">1</dt>
          <dd class="mono">Question driving both</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="container home-bento-wrap">
    <div class="home-bento reveal">
      <a class="bento-tile bento-tile--research1" href={withBase('/research')}>
        <ThemeGlyph class="bento-tile__glyph" seed={0} />
        <span class="eyebrow">Theme 01</span>
        <h2 class="bento-tile__title">Retinal Diseasome Assembly</h2>
        <p class="bento-tile__body">
          How unrelated genetic mutations converge on a finite set of disease-onset programs in
          the retina, from inherited degenerations to age-related macular degeneration.
        </p>
        <span class="mono bento-tile__link">Read more →</span>
      </a>

      <a class="bento-tile bento-tile--research2" href={withBase('/research')}>
        <ThemeGlyph class="bento-tile__glyph" seed={1} />
        <span class="eyebrow">Theme 02</span>
        <h2 class="bento-tile__title">Environmental–Molecular Interactions in Retinal Aging</h2>
        <p class="bento-tile__body">
          How lifestyle factors like nutrition shape the retina's molecular landscape, and what
          that means for age-related vision decline.
        </p>
        <span class="mono bento-tile__link">Read more →</span>
      </a>

      {
        pi && (
          <a class="bento-tile bento-tile--team" href={withBase('/team')}>
            <Avatar name={pi.data.name} size={56} class="bento-tile__avatar" />
            <span class="eyebrow">Led by</span>
            <h2 class="bento-tile__title">{pi.data.name}</h2>
            <p class="bento-tile__body">{pi.data.bioShort}</p>
            <span class="mono bento-tile__link">Meet the team →</span>
          </a>
        )
      }

      <a class="bento-tile bento-tile--news" href={withBase('/news')}>
        <span class="eyebrow">Latest</span>
        <h2 class="bento-tile__title">News</h2>
        <ul class="bento-tile__news-list">
          {
            latestNews.slice(0, 2).map((post) => (
              <li>
                <span class="mono bento-tile__news-date">
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </span>
                {post.data.title}
              </li>
            ))
          }
        </ul>
        <span class="mono bento-tile__link">See all news →</span>
      </a>

      <a class="bento-tile bento-tile--contact section-ink" href={withBase('/contact')}>
        <span class="eyebrow">Find us</span>
        <h2 class="bento-tile__title">Contact</h2>
        <p class="bento-tile__body">Dallas, TX</p>
        <span class="mono bento-tile__link">Get in touch →</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .network-hero__title {
    font-size: var(--text-5xl);
    letter-spacing: -0.02em;
  }

  .network-hero__mission {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    max-width: 34ch;
    color: var(--color-text-muted);
  }

  .network-hero__affiliation {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .home-statement {
    margin-top: var(--space-7);
    padding-block: var(--space-7);
  }

  .home-statement__inner {
    max-width: 62rem;
  }

  .home-statement__quote {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
    max-width: 58ch;
    margin-top: var(--space-2);
  }

  .home-statement__stats {
    display: flex;
    gap: var(--space-6);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .home-statement__stat-num {
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    color: var(--color-accent-on-ink);
    line-height: 1;
  }

  .home-statement__stats dd {
    margin-top: 0.4em;
    font-size: var(--text-sm);
    color: var(--color-on-ink-muted);
  }

  /* ---- Bento grid: Dropbox-brand-style blocks of squares ---- */
  .home-bento-wrap {
    padding-block: var(--space-7);
  }

  .home-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(180px, auto);
    gap: var(--space-3);
  }

  .bento-tile {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .bento-tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .bento-tile__glyph {
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-2);
  }

  .bento-tile__title {
    font-size: var(--text-xl);
    margin-top: 0.2em;
    margin-bottom: var(--space-2);
  }

  .bento-tile__body {
    color: inherit;
    opacity: 0.85;
    flex-grow: 1;
  }

  .bento-tile__link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .bento-tile__avatar {
    margin-bottom: var(--space-2);
  }

  .bento-tile__news-list {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .bento-tile__news-list li {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .bento-tile__news-date {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .bento-tile--research1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    justify-content: center;
  }

  .bento-tile--research1 .bento-tile__title {
    font-size: var(--text-2xl);
  }

  .bento-tile--research2 {
    grid-column: 3 / 5;
    grid-row: 1 / 2;
    background: var(--color-accent-soft);
    border: none;
  }

  .bento-tile--team {
    grid-column: 3 / 4;
    grid-row: 2 / 3;
  }

  .bento-tile--news {
    grid-column: 4 / 5;
    grid-row: 2 / 3;
  }

  .bento-tile--contact {
    grid-column: 1 / 5;
    grid-row: 3 / 4;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* .section-ink (global.css) loses a specificity tie against this
       component's own scoped .bento-tile rule, so it never actually
       applied — set the ink treatment directly here instead. */
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-color: var(--color-on-ink-border);
  }

  .bento-tile--contact .bento-tile__title {
    margin-bottom: 0;
  }

  .bento-tile--contact .bento-tile__body {
    flex-grow: 0;
    color: var(--color-on-ink-muted);
    opacity: 1;
  }

  .bento-tile--contact .bento-tile__link {
    margin-top: 0;
    white-space: nowrap;
    color: var(--color-accent-on-ink);
  }

  @media (max-width: 720px) {
    .home-bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .bento-tile--research1,
    .bento-tile--research2,
    .bento-tile--team,
    .bento-tile--news,
    .bento-tile--contact {
      grid-column: 1 / 2;
      grid-row: auto;
    }

    .bento-tile--contact {
      flex-direction: column;
      align-items: flex-start;
    }

    .home-statement__stats {
      gap: var(--space-4);
    }
  }
</style>
