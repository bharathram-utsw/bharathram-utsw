---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkHero from '../components/NetworkHero.astro';
import Carousel from '../components/Carousel.astro';
import { withBase } from '../lib/url';

const publications = await getCollection('publications');
const team = await getCollection('team');
const pi = team.find((m) => m.data.isPI);

const recentNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recentPubs = publications
  .slice()
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 8)
  .map((p) => {
    const href = p.data.doi ?? p.data.url;
    return {
      title: p.data.title,
      journal: p.data.journal,
      year: p.data.year,
      image: p.data.image,
      imageAlt: p.data.imageAlt,
      href: href ?? withBase('/publications'),
      external: Boolean(href),
    };
  });
---

<BaseLayout title="Mondal Lab">
  <div class="container home">
    <div class="home__hero reveal">
      <div class="home__intro">
        <h1>Mondal Lab</h1>
        <p class="mono home__affiliation">
          UT Southwestern Medical Center · Department of Ophthalmology · Dallas, TX
        </p>
      </div>

      <div id="publications" class="home__hero-graph">
        <NetworkHero />
      </div>
    </div>

    <section class="home__updates reveal">
      <div class="widget home__updates-box">
        <p class="widget__label">Updates</p>
        <ul class="home__updates-list">
          {
            recentNews.map((post) => {
              const href =
                post.data.type === 'press' && post.data.externalUrl
                  ? post.data.externalUrl
                  : withBase(`/news/${post.id}/`);
              return (
                <li>
                  <a href={href} target={post.data.type === 'press' ? '_blank' : undefined} rel={post.data.type === 'press' ? 'noopener noreferrer' : undefined}>
                    <span class="mono home__updates-date">
                      {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </span>
                    <span class="home__updates-title">{post.data.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <a class="mono home__updates-link" href={withBase('/news')}>
          All news →
        </a>
      </div>

      <div class="widget home__mission-box">
        <p class="widget__label">Mission</p>
        <p class="prose home__mission-quote">
          “Vision is critical to quality of life. Our mission is to use computational network
          biology to discover mechanisms that maintain healthy vision and identify the earliest
          molecular patterns linked with blindness.”
        </p>
      </div>

      {
        pi && (
          <div class="widget home__pi-box">
            <p class="widget__label">Principal Investigator</p>
            <div class="home__pi">
              <p class="home__pi-name">{pi.data.name}</p>
              <p class="mono home__pi-role">{pi.data.role}</p>
            </div>
            <a class="mono home__pi-link" href={withBase('/team')}>
              Full bio →
            </a>
          </div>
        )
      }
    </section>

    <div class="home__explore reveal">
      <section class="home__explore-col">
        <span class="eyebrow">Recent publications</span>
        <Carousel label="Recent publications">
          {
            recentPubs.map((pub) => (
              <a
                class="pub-slide carousel__slide"
                href={pub.href}
                target={pub.external ? '_blank' : undefined}
                rel={pub.external ? 'noopener noreferrer' : undefined}
              >
                {pub.image ? (
                  <span class="pub-slide__figure">
                    <img src={withBase(pub.image)} alt={pub.imageAlt ?? ''} loading="lazy" />
                  </span>
                ) : (
                  <span class="mono pub-slide__year">{pub.year}</span>
                )}
                <span class="pub-slide__body">
                  <span class="pub-slide__title">{pub.title}</span>
                  <span class="mono pub-slide__meta">
                    {pub.journal} · {pub.year}
                  </span>
                </span>
              </a>
            ))
          }
        </Carousel>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-5) var(--space-7);
  }

  /* The one section that stays full-bleed instead of settling into the
     new centered .container — breaks out to the true viewport width
     (the standard calc(50% - 50vw) trick) and reapplies .container's old
     viewport-scaling padding formula so it keeps its previous edge-to-
     edge look regardless of how narrow --content-width makes everything
     below it. */
  .home__hero {
    display: grid;
    grid-template-columns: minmax(320px, 1fr) minmax(280px, 1fr);
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-inline: clamp(var(--space-5), 8vw, 10rem);
  }

  .home__hero-graph {
    height: 100%;
  }

  .home__intro h1 {
    font-size: var(--text-4xl);
  }

  .home__affiliation {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .home__explore {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  /* Flex items default to min-width: auto too, so the wide carousel
     track inside would still grow this row — and the page — to fit its
     content instead of scrolling internally, same issue a grid column
     had before this became a stacked flex layout. */
  .home__explore-col {
    min-width: 0;
  }

  .pub-slide {
    display: flex;
    flex-direction: column;
    width: min(85%, 19rem);
    height: 16rem;
    background: var(--color-bg-raised);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.15s var(--ease-out);
  }

  .pub-slide:hover,
  .pub-slide:focus-visible {
    box-shadow: var(--shadow-card-hover);
  }

  .pub-slide__figure {
    display: block;
    height: 7.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-inset);
    overflow: hidden;
  }

  .pub-slide__figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    transition: filter 0.3s var(--ease-out);
  }

  .pub-slide:hover .pub-slide__figure img,
  .pub-slide:focus-visible .pub-slide__figure img {
    filter: grayscale(0);
  }

  .pub-slide__year {
    display: block;
    padding: var(--space-3) var(--space-3) 0;
    font-size: var(--text-3xl);
    color: var(--color-text-faint);
  }

  .pub-slide__body {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding: var(--space-3);
    overflow: hidden;
  }

  .pub-slide__title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s var(--ease-out);
  }

  .pub-slide:hover .pub-slide__title,
  .pub-slide:focus-visible .pub-slide__title {
    color: var(--color-accent);
  }

  .pub-slide__meta {
    margin-top: auto;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ---- Updates + Mission + Principal Investigator ---- */
  .home__updates {
    display: flex;
    align-items: stretch;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  /* Sizing only — background, box-shadow, and padding all come from the
     shared .widget rule (global.css) now, same as every other card. */
  .home__updates-box,
  .home__mission-box,
  .home__pi-box {
    flex: 1 1 0;
    min-width: 0;
  }

  .home__updates-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .home__updates-list a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .home__updates-date {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .home__updates-title {
    font-weight: 600;
    transition: color 0.15s var(--ease-out);
  }

  .home__updates-list a:hover .home__updates-title {
    color: var(--color-accent);
  }

  .home__updates-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .home__updates-link:hover {
    text-decoration: underline;
  }

  .home__mission-quote {
    font-style: italic;
  }

  .home__pi-name {
    font-weight: 700;
  }

  .home__pi-role {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .home__pi-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .home__pi-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .home__hero {
      grid-template-columns: 1fr;
    }

    .home__updates {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .home__intro h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
