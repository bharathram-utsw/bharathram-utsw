---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NetworkHero from '../components/NetworkHero.astro';
import Carousel from '../components/Carousel.astro';
import Avatar from '../components/Avatar.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { isVisionEra } from '../lib/publications';
import { withBase } from '../lib/url';

const publications = await getCollection('publications');
const team = await getCollection('team');
const pi = team.find((m) => m.data.isPI);

const visionPubs = publications.filter((p) => isVisionEra(p.data.keywords));
const keywordCounts = new Map<string, number>();
for (const pub of visionPubs) {
  for (const kw of pub.data.keywords) {
    keywordCounts.set(kw, (keywordCounts.get(kw) ?? 0) + 1);
  }
}
const topTopics = [...keywordCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

// A Material Symbols icon per topic (see TopicIcon.astro) — falls back to
// a generic "science" flask for any keyword not in this list, so a new
// publication's keywords never break the layout. Names are real Material
// Symbols glyph names from fonts.google.com/icons (outlined style).
const TOPIC_ICONS: Record<string, string> = {
  metabolism: 'local_fire_department',
  retina: 'visibility',
  aging: 'hourglass',
  photoreceptor: 'biotech',
  transcriptomics: 'bar_chart',
  reserpine: 'medication',
  epigenome: 'genetics',
  'retinal degeneration': 'warning',
  'photoreceptor degeneration': 'warning',
  diet: 'nutrition',
  'retinal organoids': 'experiment',
  'stem cells': 'eco',
};

const topicSlides = topTopics.map(([label, count]) => ({
  label,
  count,
  icon: TOPIC_ICONS[label.toLowerCase()] ?? 'science',
}));

const recentPubs = publications
  .slice()
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 8)
  .map((p) => {
    const href = p.data.doi ?? p.data.url;
    return {
      title: p.data.title,
      journal: p.data.journal,
      year: p.data.year,
      image: p.data.image,
      imageAlt: p.data.imageAlt,
      href: href ?? withBase('/publications'),
      external: Boolean(href),
    };
  });
---

<BaseLayout title="Mondal Lab">
  <div class="container home">
    <div class="home__hero reveal">
      <div class="home__intro">
        <h1>Mondal Lab</h1>
        <p class="mono home__affiliation">
          UT Southwestern Medical Center · Department of Ophthalmology · Dallas, TX
        </p>
      </div>

      <div id="publications" class="home__hero-graph">
        <NetworkHero />
      </div>
    </div>

    <section class="home__mission reveal">
      <SectionHeading eyebrow="Why we do this" level="h2">
        Mission
      </SectionHeading>
      <p class="prose home__mission-statement">
        We combine computational biology — genomics, epigenomics, metabolism, and network analysis —
        to discover mechanisms that maintain healthy vision and identify the earliest molecular
        patterns linked with blindness.
      </p>
      <ul class="home__mission-list">
        <li>
          <strong>Multi-omic integration</strong> — genomic, transcriptomic, and proteomic data, unified
          into a shared map of how distinct genetic and pathological causes converge on the same
          retinal disease programs.
        </li>
        <li>
          <strong>Controlled environmental interventions</strong> — diet and other lifestyle variables
          tested directly in mouse models, to study how they shape the retina's epigenetic and
          metabolic aging.
        </li>
        <li>
          <strong>Network-based analysis</strong> — treating disease mechanism as a graph problem, linking
          molecular pathways across conditions rather than studying each in isolation.
        </li>
      </ul>
    </section>

    <div class="home__explore reveal">
      <section class="home__explore-col">
        <span class="eyebrow">Recent publications</span>
        <Carousel label="Recent publications">
          {
            recentPubs.map((pub) => (
              <a
                class="pub-slide corner-frame carousel__slide"
                href={pub.href}
                target={pub.external ? '_blank' : undefined}
                rel={pub.external ? 'noopener noreferrer' : undefined}
              >
                {pub.image ? (
                  <span class="pub-slide__figure">
                    <img src={withBase(pub.image)} alt={pub.imageAlt ?? ''} loading="lazy" />
                  </span>
                ) : (
                  <span class="mono pub-slide__year">{pub.year}</span>
                )}
                <span class="pub-slide__body">
                  <span class="pub-slide__title">{pub.title}</span>
                  <span class="mono pub-slide__meta">
                    {pub.journal} · {pub.year}
                  </span>
                </span>
              </a>
            ))
          }
        </Carousel>
      </section>

      <section class="home__explore-col">
        <span class="eyebrow">Research topics</span>
        <Carousel label="Research topics">
          {
            topicSlides.map((topic) => (
              <a class="topic-slide corner-frame carousel__slide" href={withBase('/publications')}>
                <span class="topic-slide__icon" aria-hidden="true">
                  <TopicIcon name={topic.icon} class="topic-slide__icon-svg" />
                </span>
                <span class="topic-slide__label">{topic.label}</span>
                <span class="mono topic-slide__count">
                  {topic.count} {topic.count === 1 ? 'paper' : 'papers'}
                </span>
              </a>
            ))
          }
        </Carousel>
      </section>
    </div>

    {
      pi && (
        <section class="home__labhead reveal">
          <SectionHeading eyebrow="Principal investigator" level="h2">
            Lab Head
          </SectionHeading>
          <div class="labhead">
            <div class="labhead__photo-frame corner-frame">
              <Avatar name={pi.data.name} size={220} class="labhead__photo" />
            </div>
            <div class="labhead__body">
              <h3>{pi.data.name}</h3>
              <p class="mono labhead__role">{pi.data.role}</p>
              {pi.data.bioShort && <p class="prose labhead__bio">{pi.data.bioShort}</p>}
              <a class="mono labhead__link" href={withBase('/team')}>
                Full bio →
              </a>
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-5) var(--space-7);
  }

  /* The one section that stays full-bleed instead of settling into the
     new centered .container — breaks out to the true viewport width
     (the standard calc(50% - 50vw) trick) and reapplies .container's old
     viewport-scaling padding formula so it keeps its previous edge-to-
     edge look regardless of how narrow --content-width makes everything
     below it. */
  .home__hero {
    display: grid;
    grid-template-columns: minmax(320px, 1fr) minmax(280px, 1fr);
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-inline: clamp(var(--space-5), 8vw, 10rem);
  }

  .home__hero-graph {
    height: 100%;
  }

  .home__intro h1 {
    font-size: var(--text-4xl);
  }

  .home__affiliation {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  /* ---- Explore: two full-width carousel rows, not side-by-side columns
     — a 50/50 split never actually matched, since narrow topic-slides
     and wider pub-slides fit different counts per row at the same
     column width, so the two carousels never lined up as a pair no
     matter how the alignment was tuned. Stacked rows sidestep that:
     each one spans the full container and is judged on its own. ---- */
  .home__explore {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  /* Flex items default to min-width: auto too, so the wide carousel
     track inside would still grow this row — and the page — to fit its
     content instead of scrolling internally, same issue a grid column
     had before this became a stacked flex layout. */
  .home__explore-col {
    min-width: 0;
  }

  .pub-slide {
    display: flex;
    flex-direction: column;
    width: min(85%, 19rem);
    height: 16rem;
    background: var(--color-bg-raised);
    text-decoration: none;
    color: inherit;
    /* An explicit zero-shadow rest state (not the implicit `none`) gives
       the hover transition a matching shape to interpolate from —
       animating box-shadow from `none` snaps instead of easing in some
       browsers, which is what read as a "shake" on click. */
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow 0.15s var(--ease-out);
  }

  .pub-slide:hover,
  .pub-slide:focus-visible {
    box-shadow: var(--shadow-card-hover);
  }

  .pub-slide__figure {
    display: block;
    height: 7.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-inset);
    overflow: hidden;
  }

  .pub-slide__figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    transition: filter 0.3s var(--ease-out);
  }

  .pub-slide:hover .pub-slide__figure img,
  .pub-slide:focus-visible .pub-slide__figure img {
    filter: grayscale(0);
  }

  .pub-slide__year {
    display: block;
    padding: var(--space-3) var(--space-3) 0;
    font-size: var(--text-3xl);
    color: var(--color-text-faint);
  }

  .pub-slide__body {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding: var(--space-3);
    overflow: hidden;
  }

  .pub-slide__title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s var(--ease-out);
  }

  .pub-slide:hover .pub-slide__title,
  .pub-slide:focus-visible .pub-slide__title {
    color: var(--color-accent);
  }

  .pub-slide__meta {
    margin-top: auto;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .topic-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6em;
    width: 11.5rem;
    height: 16rem;
    justify-content: center;
    background: var(--color-bg-raised);
    text-decoration: none;
    color: inherit;
    /* See .pub-slide's comment — a real zero-shadow rest state so the
       hover shadow eases in instead of popping in. */
    box-shadow: 0 0 0 0 transparent;
    transition:
      background 0.15s var(--ease-out),
      box-shadow 0.15s var(--ease-out);
  }

  .topic-slide:hover,
  .topic-slide:focus-visible {
    background: var(--color-accent-soft);
    box-shadow: var(--shadow-card-hover);
  }

  .topic-slide__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* TopicIcon renders a raw <svg> via set:html — Astro only scopes
     elements it writes literally in this file's own template, so the
     class passed as a prop needs :global() to actually match it. */
  :global(.topic-slide__icon-svg) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .topic-slide__label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .topic-slide__count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ---- Mission ---- */
  .home__mission {
    max-width: 62ch;
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .home__mission-statement {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .home__mission-list {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .home__mission-list li {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .home__mission-list strong {
    color: var(--color-accent);
  }

  /* ---- Lab Head ---- */
  .labhead {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .labhead__photo-frame {
    flex-shrink: 0;
  }

  /* Avatar is a child component — its root <svg> only ever carries
     Avatar's own scope attribute, never this page's, even for a class
     passed in as a prop, so this needs :global(). */
  :global(.labhead__photo) {
    display: block;
  }

  .labhead__body h3 {
    font-size: var(--text-2xl);
  }

  .labhead__role {
    color: var(--color-accent);
    font-size: var(--text-sm);
    margin-block: 0.3em var(--space-2);
  }

  .labhead__bio {
    max-width: 52ch;
    color: var(--color-text-muted);
  }

  .labhead__link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .labhead__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .home__hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .home__intro h1 {
      font-size: var(--text-2xl);
    }

    .labhead {
      flex-direction: column;
    }
  }
</style>
