---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationNetwork from '../components/PublicationNetwork.astro';
import PublicationCard from '../components/PublicationCard.astro';
import NetworkDivider from '../components/NetworkDivider.astro';

const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const resources = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Publications"
  description="Publications by Anupam Mondal, Ph.D. — from retinal disease and epigenetics to microbial and comparative genomics, the full record from Google Scholar."
>
  <div class="container publications-page">
    <SectionHeading level="h1">Publications</SectionHeading>

    <div class="publications-page__section reveal">
      <PublicationNetwork />
    </div>

    <div class="publications-page__controls">
      <span class="mono publications-page__count" id="pub-count">{publications.length} shown</span>
      <div class="publications-page__sort" role="group" aria-label="Sort publications">
        <button type="button" class="mono" data-sort="year" data-active="true">Newest</button>
        <button type="button" class="mono" data-sort="citations">Most cited</button>
      </div>
    </div>

    <div class="publications-page__grid" id="pub-grid">
      {publications.map((pub) => <PublicationCard id={pub.id} publication={pub.data} />)}
    </div>

    <NetworkDivider />

    <section class="publications-page__section reveal resources">
      <span class="eyebrow">For other researchers</span>
      <h2>Resources</h2>
      <ul class="resources__list">
        {
          resources.map((r) => (
            <li class="resources__item">
              {r.data.url ? (
                <a class="resources__title" href={r.data.url} target="_blank" rel="noopener noreferrer">
                  {r.data.title}
                </a>
              ) : (
                <p class="resources__title">{r.data.title}</p>
              )}
              <p class="resources__desc">{r.data.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .publications-page {
    padding-block: var(--space-6);
  }

  .publications-page__section {
    margin-bottom: var(--space-6);
  }

  .publications-page__section h2 {
    margin-bottom: var(--space-2);
  }

  .publications-page__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .publications-page__count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .publications-page__sort {
    display: flex;
    gap: var(--space-1);
  }

  .publications-page__sort button {
    font-size: var(--text-xs);
    background: none;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    padding: 0.3em 0.75em;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .publications-page__sort button[data-active='true'] {
    color: var(--color-bg-raised);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* A masonry column flow, not a uniform grid — cards vary a lot in
     height (an image, or not; a long abstract, or a two-line one), so
     forcing them into equal-height grid rows left tall gaps under the
     short ones. Each card gets its own margin-bottom (columns has no
     row-gap concept) and break-inside: avoid so it never splits across
     a column. */
  .publications-page__grid {
    columns: 5;
    column-gap: var(--space-3);
  }

  .publications-page__grid > :global(*) {
    margin-bottom: var(--space-3);
  }

  @media (max-width: 1400px) {
    .publications-page__grid {
      columns: 4;
    }
  }

  @media (max-width: 1100px) {
    .publications-page__grid {
      columns: 3;
    }
  }

  @media (max-width: 860px) {
    .publications-page__grid {
      columns: 2;
    }
  }

  @media (max-width: 640px) {
    .publications-page__grid {
      columns: 1;
    }
  }

  @media (max-width: 640px) {
    .publications-page__controls {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }

  .resources h2 {
    margin-top: 0.2em;
    margin-bottom: var(--space-4);
  }

  .resources__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--prose-width);
  }

  .resources__item {
    padding: var(--space-3);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-card);
    transition: background 0.15s var(--ease-out);
  }

  .resources__item:hover {
    background: var(--color-bg-inset);
  }

  .resources__title {
    display: block;
    margin-bottom: 0.3em;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
  }

  a.resources__title:hover {
    color: var(--color-accent);
  }

  .resources__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>

<script>
  const grid = document.getElementById('pub-grid');
  const countEl = document.getElementById('pub-count');
  const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort]');

  function updateCount() {
    if (!grid || !countEl) return;
    const cards = grid.querySelectorAll<HTMLElement>('[data-pub-card]');
    const visible = [...cards].filter((c) => c.dataset.dimmed !== 'true').length;
    countEl.textContent = visible === cards.length ? `${cards.length} shown` : `${visible} of ${cards.length} shown`;
  }

  document.addEventListener('pub-filter-change', updateCount);
  // PublicationNetwork may have already applied a filter (and fired its
  // event) before this listener was registered — sync once on load too.
  updateCount();

  sortButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!grid) return;
      sortButtons.forEach((b) => (b.dataset.active = 'false'));
      btn.dataset.active = 'true';
      const key = btn.dataset.sort as 'year' | 'citations';
      const cards = [...grid.querySelectorAll<HTMLElement>('[data-pub-card]')];
      cards.sort((a, b) => {
        const av = Number(a.dataset[key] ?? 0);
        const bv = Number(b.dataset[key] ?? 0);
        return bv - av;
      });
      cards.forEach((c) => grid.appendChild(c));
    });
  });
</script>
