---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import NetworkDivider from '../components/NetworkDivider.astro';
import { withBase } from '../lib/url';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const pi = team.find((m) => m.data.isPI);
const postdocs = team.filter((m) => !m.data.isPI && m.data.role.includes('Postdoctoral'));
const staff = team.filter((m) => !m.data.isPI && !m.data.role.includes('Postdoctoral'));
---

<BaseLayout title="Team" description="Meet the Mondal Lab team at UT Southwestern Medical Center.">
  <div class="container team-page">
    <SectionHeading level="h1">Team</SectionHeading>

    {
      pi && (
        <div class="team-page__pi">
          <TeamMemberCard member={pi} featured />
        </div>
      )
    }

    {
      postdocs.length > 0 && (
        <>
          <p class="widget__label team-page__roster-label">Postdoctoral Research</p>
          <div class="team-page__roster">
            {postdocs.map((member) => <TeamMemberCard member={member} />)}
          </div>
        </>
      )
    }

    {
      staff.length > 0 && (
        <>
          <p class="widget__label team-page__roster-label">Lab Administration</p>
          <div class="team-page__roster">
            {staff.map((member) => <TeamMemberCard member={member} />)}
          </div>
        </>
      )
    }

    <NetworkDivider />

    <div class="widget team-page__hiring">
      <p class="widget__label">Join the lab</p>
      <h2>We're hiring</h2>
      <p class="prose">
        The lab is actively looking for talented postdocs and graduate students interested in the
        computational biology of vision and aging — genomics, epigenomics, metabolism, and network
        analysis applied to retinal disease. Applications are welcome from postdoctoral, graduate,
        and intern candidates alike.
      </p>
      <div class="team-page__hiring-grid">
        <div>
          <p class="mono team-page__hiring-label">To apply</p>
          <p class="prose">Send a CV and a short note on your research interests.</p>
        </div>
      </div>
      <p class="mono team-page__hiring-contact">Contact: — (coming soon, see the <a href={withBase('/contact')}>Contact</a> page)</p>
    </div>
  </div>
</BaseLayout>

<style>
  .team-page {
    padding-block: var(--space-6);
  }

  .team-page__pi {
    margin-bottom: var(--space-6);
  }

  .team-page__roster-label {
    margin-bottom: var(--space-2);
  }

  .team-page__roster {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .team-page__hiring h2 {
    margin-top: 0.2em;
    margin-bottom: var(--space-2);
  }

  .team-page__hiring-grid {
    max-width: 28rem;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .team-page__hiring-label {
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin-bottom: 0.4em;
  }

  .team-page__hiring-contact {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

</style>
