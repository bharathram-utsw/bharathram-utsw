---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import NetworkDivider from '../components/NetworkDivider.astro';
import { withBase } from '../lib/url';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Team" description="Meet the Mondal Lab team at UT Southwestern Medical Center.">
  <div class="container team-page">
    <SectionHeading eyebrow="Who we are" level="h1">Team</SectionHeading>

    <p class="widget__label team-page__roster-label">Roster · {team.length} {team.length === 1 ? 'member' : 'members'}</p>
    <div class="team-page__roster">
      {team.map((member) => <TeamMemberCard member={member} />)}
    </div>

    <NetworkDivider />

    <div class="widget team-page__hiring">
      <p class="widget__label">Join the lab</p>
      <h2>We're hiring</h2>
      <p class="prose">
        The lab is actively looking for talented postdocs and graduate students interested in the
        computational biology of vision and aging — genomics, epigenomics, metabolism, and network
        analysis applied to retinal disease.
      </p>
      <div class="team-page__hiring-grid">
        <div>
          <p class="mono team-page__hiring-label">Postdoctoral fellows</p>
          <p class="prose">
            Background in computational biology, bioinformatics, or a related quantitative field.
            Wet-lab experience is a plus but not required.
          </p>
        </div>
        <div>
          <p class="mono team-page__hiring-label">Graduate students</p>
          <p class="prose">
            Rotations welcome from UT Southwestern's graduate programs. Reach out to discuss
            current project openings.
          </p>
        </div>
        <div>
          <p class="mono team-page__hiring-label">To apply</p>
          <p class="prose">Send a CV and a short note on your research interests.</p>
        </div>
      </div>
      <p class="mono team-page__hiring-contact">Contact: — (coming soon, see the <a href={withBase('/contact')}>Contact</a> page)</p>
    </div>
  </div>
</BaseLayout>

<style>
  .team-page {
    padding-block: var(--space-6);
  }

  .team-page__roster-label {
    margin-bottom: var(--space-2);
  }

  .team-page__roster {
    margin-bottom: var(--space-6);
  }

  .team-page__hiring h2 {
    margin-top: 0.2em;
    margin-bottom: var(--space-2);
  }

  .team-page__hiring-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-bg-inset);
  }

  .team-page__hiring-grid > div + div {
    border-left: 1px solid var(--color-bg-inset);
    padding-left: var(--space-4);
  }

  .team-page__hiring-label {
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin-bottom: 0.4em;
  }

  .team-page__hiring-contact {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .team-page__hiring-grid {
      grid-template-columns: 1fr;
    }

    .team-page__hiring-grid > div + div {
      border-left: none;
      border-top: 1px solid var(--color-bg-inset);
      padding-left: 0;
      padding-top: var(--space-3);
    }
  }
</style>
