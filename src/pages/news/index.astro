---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NewsCard from '../../components/NewsCard.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="News" description="News and updates from the Mondal Lab.">
  <div class="container news-page">
    <SectionHeading eyebrow="Lab updates" level="h1">News</SectionHeading>
    <div class="news-page__grid">
      {posts.map((post) => <NewsCard post={post} headingLevel="h2" />)}
    </div>
  </div>
</BaseLayout>

<style>
  .news-page {
    padding-block: var(--space-6);
  }

  .news-page__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .news-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
