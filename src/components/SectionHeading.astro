---
interface Props {
  eyebrow?: string;
  level?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { eyebrow, level = 'h2', class: className } = Astro.props;
const Tag = level;
---

<div class:list={['section-heading', className]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag class="section-heading__title">
    <slot />
  </Tag>
  {Astro.slots.has('lede') && <div class="section-heading__lede prose"><slot name="lede" /></div>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-4);
  }

  .section-heading__title {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  /* A small accent marker on every section heading site-wide — one more
     place the signal blue shows up beyond nav/links/eyebrows. */
  .section-heading__title::before {
    content: '';
    flex-shrink: 0;
    width: 0.5em;
    height: 0.5em;
    background: var(--color-accent);
  }

  .section-heading__lede {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
