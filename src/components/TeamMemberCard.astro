---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';
import TopicIcon from './TopicIcon.astro';

interface Props {
  member: CollectionEntry<'team'>;
  // The PI's card reads as the lead of the roster, not just another
  // entry in the grid — bigger photo, bigger name, sits alone above the
  // rest rather than sharing a row with them.
  featured?: boolean;
}

const { member, featured = false } = Astro.props;
const { data, body } = member;
const hasBio = Boolean(body?.trim());
const { Content } = await render(member);
const avatarSize = featured ? 320 : 224;

// A Material Symbols icon per interest (same source as Home's
// TopicIcon — real glyph names from fonts.google.com/icons) — falls back
// to a generic star for anything not in this list, so a new member's
// interests never break the layout.
const HOBBY_ICONS: Record<string, string> = {
  climbing: 'hiking',
  running: 'directions_run',
  mountains: 'landscape',
  hiking: 'hiking',
  history: 'history_edu',
  travel: 'flight',
  cooking: 'restaurant',
  reading: 'menu_book',
  music: 'music_note',
  photography: 'photo_camera',
  cycling: 'directions_bike',
  swimming: 'pool',
};
---

<article class:list={['team-card', { 'team-card--featured': featured }]}>
  <div class="team-card__photo-frame">
    <Avatar name={data.name} size={avatarSize} class="team-card__photo" />
  </div>
  <div class="team-card__body">
    <h2>{data.name}</h2>
    <p class="mono team-card__role">{data.role}</p>
    {
      hasBio ? (
        <div class="prose team-card__bio">
          <Content />
        </div>
      ) : (
        <p class="team-card__coming-soon">Bio coming soon.</p>
      )
    }
    {
      data.interests.length > 0 && (
        <div class="team-card__interests">
          <span class="mono team-card__interests-label">Hobbies:</span>
          <ul class="team-card__interests-list">
            {data.interests.map((interest) => (
              <li title={interest}>
                <TopicIcon name={HOBBY_ICONS[interest.toLowerCase()] ?? 'star'} class="team-card__interest-icon" />
                <span class="visually-hidden">{interest}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {data.email && (
      <a class="mono team-card__email" href={`mailto:${data.email}`}>{data.email}</a>
    )}
  </div>
</article>

<style>
  .team-card {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
  }

  /* Featured (PI) card: bigger photo column, a top accent bar, and a
     bigger name — the visual hierarchy the roster was missing between
     the lead and the rest of the team. */
  .team-card--featured {
    grid-template-columns: 18rem 1fr;
    border-top: 3px solid var(--color-accent);
    padding-top: calc(var(--space-4) - 2px);
  }

  .team-card--featured .team-card__body h2 {
    font-size: var(--text-3xl);
  }

  .team-card__photo-frame {
    overflow: hidden;
  }

  /* Avatar is a child component — Astro doesn't stamp this component's
     scope attribute onto elements a child renders, even for a class
     passed in as a prop, so this needs :global() or it silently never
     matches. */
  :global(.team-card__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    filter: grayscale(1);
    transition: filter 0.3s var(--ease-out);
  }

  .team-card:hover :global(.team-card__photo),
  .team-card:focus-within :global(.team-card__photo) {
    filter: grayscale(0);
  }

  .team-card__body h2 {
    font-size: var(--text-xl);
  }

  .team-card__role {
    color: var(--color-accent);
    font-size: var(--text-sm);
    margin-block: 0.25em var(--space-2);
  }

  .team-card__coming-soon {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .team-card__bio :global(p) + :global(p) {
    margin-top: var(--space-2);
  }

  .team-card__interests {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7em;
    margin-top: var(--space-3);
  }

  .team-card__interests-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .team-card__interests-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  .team-card__interests-list li {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* TopicIcon renders a raw <svg> via set:html — Astro only scopes
     elements it writes literally in this file's own template, so the
     class passed as a prop needs :global() to actually match it. */
  :global(.team-card__interest-icon) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .team-card__email {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .team-card {
      grid-template-columns: 1fr;
    }

    .team-card__photo-frame {
      max-width: 10rem;
    }
  }
</style>
