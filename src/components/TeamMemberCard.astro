---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { data, body } = member;
const hasBio = Boolean(body?.trim());
const { Content } = await render(member);

// A small icon per interest — falls back to a plain bullet for anything
// not in this list, so a new member's interests never break the layout.
const HOBBY_ICONS: Record<string, string> = {
  climbing: '🧗',
  running: '🏃',
  mountains: '⛰️',
  hiking: '🥾',
  history: '📜',
  travel: '✈️',
  cooking: '🍳',
  reading: '📚',
  music: '🎵',
  photography: '📷',
  cycling: '🚴',
  swimming: '🏊',
};
---

<article class="team-card">
  <div class="team-card__photo-frame">
    <Avatar name={data.name} size={224} class="team-card__photo" />
  </div>
  <div class="team-card__body">
    <h2>{data.name}</h2>
    <p class="mono team-card__role">{data.role}</p>
    {
      hasBio ? (
        <div class="prose team-card__bio">
          <Content />
        </div>
      ) : (
        <p class="team-card__coming-soon">Bio coming soon.</p>
      )
    }
    {
      data.interests.length > 0 && (
        <ul class="mono team-card__interests">
          {data.interests.map((interest) => (
            <li>
              <span aria-hidden="true">{HOBBY_ICONS[interest.toLowerCase()] ?? '•'}</span> {interest}
            </li>
          ))}
        </ul>
      )
    }
    {data.email && (
      <a class="mono team-card__email" href={`mailto:${data.email}`}>{data.email}</a>
    )}
  </div>
</article>

<style>
  .team-card {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
  }

  .team-card__photo-frame {
    overflow: hidden;
  }

  /* Avatar is a child component — Astro doesn't stamp this component's
     scope attribute onto elements a child renders, even for a class
     passed in as a prop, so this needs :global() or it silently never
     matches. */
  :global(.team-card__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    filter: grayscale(1);
    transition: filter 0.3s var(--ease-out);
  }

  .team-card:hover :global(.team-card__photo),
  .team-card:focus-within :global(.team-card__photo) {
    filter: grayscale(0);
  }

  .team-card__body h2 {
    font-size: var(--text-xl);
  }

  .team-card__role {
    color: var(--color-accent);
    font-size: var(--text-sm);
    margin-block: 0.25em var(--space-2);
  }

  .team-card__coming-soon {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .team-card__bio :global(p) + :global(p) {
    margin-top: var(--space-2);
  }

  .team-card__interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.2em;
    margin-top: var(--space-3);
  }

  .team-card__interests li {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .team-card__email {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .team-card {
      grid-template-columns: 1fr;
    }

    .team-card__photo-frame {
      max-width: 10rem;
    }
  }
</style>
