---
// Persistent left index rail — the site's primary navigation, present on
// every page (rendered once in BaseLayout, not per-page), matching the
// reference's own layout: a fixed-width index column running the full
// height of the page, with the actual content in a full-width pane beside
// it — not a centered container with a nav bolted onto one page.
import { withBase } from '../../lib/url';

const navItems = [
  { slug: 'home', href: '/', label: 'Home' },
  { slug: 'research', href: '/research', label: 'Research' },
  { slug: 'team', href: '/team', label: 'Team' },
  { slug: 'publications', href: '/publications', label: 'Publications' },
  { slug: 'news', href: '/news', label: 'News' },
  { slug: 'gallery', href: '/gallery', label: 'Gallery' },
  { slug: 'contact', href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isHome = currentPath === withBase('/');

// On Home itself, sections for Research/Team/Publications/News already
// exist on-page (see src/pages/index.astro) — link to those in place
// instead of navigating away. Gallery/Contact have no Home presence, so
// they always navigate normally.
const anchorable = new Set(['research', 'team', 'publications', 'news']);

function isActive(href: string) {
  const based = withBase(href);
  if (href === '/') return currentPath === based;
  return currentPath === based || currentPath.startsWith(`${based}/`);
}

function linkFor(item: (typeof navItems)[number]) {
  if (isHome && anchorable.has(item.slug)) return `#${item.slug}`;
  return withBase(item.href);
}
---

<aside class="site-sidebar">
  <nav aria-label="Primary">
    <p class="site-sidebar__label">Index</p>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              class="mono"
              href={linkFor(item)}
              aria-current={!isHome && isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .site-sidebar {
    display: none;
    width: 14rem;
    flex-shrink: 0;
    border-right: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-3);
  }

  @media (min-width: 860px) {
    .site-sidebar {
      display: block;
    }
  }

  .site-sidebar__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .site-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-sidebar a {
    display: block;
    padding-block: 0.5em;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-bg-inset);
  }

  .site-sidebar li:last-child a {
    border-bottom: none;
  }

  .site-sidebar a:hover {
    color: var(--color-text);
  }

  .site-sidebar a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
