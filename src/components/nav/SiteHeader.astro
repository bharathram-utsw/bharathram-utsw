---
// The lab's icon is the one nav trigger, site-wide (desktop and mobile
// alike) — SiteSidebar and the taskbar's old "Start" button are both gone;
// this is the single, visible place to reach the rest of the site.
import { withBase } from '../../lib/url';
import SearchPalette from '../SearchPalette.astro';

const today = new Date()
  .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
  .toUpperCase();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/team', label: 'Team' },
  { href: '/publications', label: 'Publications' },
  { href: '/news', label: 'News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const based = withBase(href);
  if (href === '/') return currentPath === based;
  return currentPath === based || currentPath.startsWith(`${based}/`);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <details class="site-header__nav">
      <summary class="site-header__nav-trigger" aria-haspopup="true" aria-label="Open menu">
        <img src={withBase('/icon.png')} alt="" class="site-header__mark" />
      </summary>
      <nav class="site-header__menu" aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <a class="site-header__wordmark" href={withBase('/')}>
      <span class="site-header__name">Mondal Lab</span>
    </a>

    <p class="mono site-header__date" aria-hidden="true">
      {today} · DALLAS, TX <span class="site-header__cursor" aria-hidden="true">▍</span>
    </p>

    <div class="site-header__search">
      <SearchPalette />
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 0.6rem;
  }

  .site-header__nav {
    position: relative;
  }

  .site-header__nav-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.6em;
    height: 2.6em;
    padding: 0.3em;
    border: 1px solid transparent;
    cursor: pointer;
    list-style: none;
    transition:
      background 0.15s var(--ease-out),
      border-color 0.15s var(--ease-out);
  }

  .site-header__nav-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header__nav-trigger:hover {
    background: var(--color-bg-inset);
    border-color: var(--color-border);
  }

  .site-header__nav[open] .site-header__nav-trigger {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .site-header__mark {
    width: 100%;
    height: 100%;
  }

  .site-header__menu {
    position: absolute;
    left: 0;
    top: calc(100% + var(--space-1));
    min-width: 12rem;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-card-hover);
    z-index: 21;
  }

  .site-header__menu ul {
    list-style: none;
    margin: 0;
    padding: var(--space-1);
  }

  .site-header__menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6em var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-header__menu a:hover {
    background: var(--color-bg-inset);
    color: var(--color-text);
  }

  .site-header__menu a[aria-current='page'] {
    color: var(--color-accent);
  }

  .site-header__wordmark {
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-header__date {
    display: none;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    margin-right: auto;
  }

  .site-header__cursor {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__cursor {
      animation: header-cursor-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes header-cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (min-width: 640px) {
    .site-header__date {
      display: block;
    }
  }

  @media (max-width: 639px) {
    .site-header__wordmark {
      margin-right: auto;
    }
  }

  .site-header__search {
    flex-shrink: 0;
    width: 9.5rem;
  }

  @media (min-width: 640px) {
    .site-header__search {
      margin-left: var(--space-3);
    }
  }
</style>

<script>
  // <details> already toggles open/closed on summary click — this just
  // adds the two extra dismiss paths a real menu needs (same pattern as
  // the taskbar's Start menu).
  const nav = document.querySelector('.site-header__nav') as HTMLDetailsElement | null;

  document.addEventListener('click', (e) => {
    if (nav?.open && !nav.contains(e.target as Node)) nav.open = false;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.open) nav.open = false;
  });
</script>
