---
import { withBase } from '../../lib/url';
import SearchPalette from '../SearchPalette.astro';

const today = new Date()
  .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
  .toUpperCase();
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <a class="site-header__wordmark" href={withBase('/')}>
      <img src={withBase('/icon.png')} alt="" class="site-header__mark" />
      <span class="site-header__name">Mondal Lab</span>
    </a>

    <p class="mono site-header__date" aria-hidden="true">
      {today} · DALLAS, TX <span class="site-header__cursor" aria-hidden="true">▍</span>
    </p>

    <div class="site-header__search">
      <SearchPalette />
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 0.6rem;
  }

  .site-header__dots {
    display: none;
    gap: 0.35em;
  }

  .site-header__dots span {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    border: 1px solid var(--color-text-faint);
  }

  @media (min-width: 640px) {
    .site-header__dots {
      display: flex;
    }
  }

  .site-header__wordmark {
    display: flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__mark {
    width: 1.8em;
    height: 1.8em;
  }

  .site-header__name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-header__date {
    display: none;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    margin-right: auto;
  }

  .site-header__cursor {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__cursor {
      animation: header-cursor-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes header-cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (min-width: 860px) {
    .site-header__date {
      display: block;
    }
  }

  .site-header__search {
    flex-shrink: 0;
    width: 9.5rem;
  }

  @media (min-width: 860px) {
    .site-header__search {
      margin-left: var(--space-3);
    }
  }

  @media (max-width: 859px) {
    .site-header__search {
      margin-right: var(--space-2);
    }
  }

  @media (max-width: 859px) {
    .site-header__wordmark {
      margin-right: auto;
    }
  }

</style>
