---
// Single-row header: the eye mark and wordmark sit inline with the real
// nav links, all always visible — no click-to-reveal menu, and no
// separate banner row for the mark (both read as "not visible enough"
// before). The mark is shown in full (object-fit: contain, no crop) since
// cropping it into a circle was hiding the eye shape and leaving only the
// circuit-pattern iris.
import { withBase } from '../../lib/url';
import SearchPalette from '../SearchPalette.astro';

const today = new Date()
  .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
  .toUpperCase();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/team', label: 'Team' },
  { href: '/publications', label: 'Publications' },
  { href: '/news', label: 'News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const based = withBase(href);
  if (href === '/') return currentPath === based;
  return currentPath === based || currentPath.startsWith(`${based}/`);
}
---

<header class="site-header">
  <div class="site-header__nav-row">
    <div class="container site-header__nav-inner">
      <a class="site-header__brand" href={withBase('/')} aria-label="Mondal Lab — Home">
        <img src={withBase('/icon.png')} alt="" class="site-header__mark" />
        <span class="site-header__wordmark">Mondal Lab</span>
      </a>

      <nav class="site-header__nav" aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__utility">
        <p class="mono site-header__date" aria-hidden="true">
          {today} <span class="site-header__cursor" aria-hidden="true">▍</span>
        </p>
        <div class="site-header__search">
          <SearchPalette />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg-raised);
    position: relative;
    z-index: 20;
  }

  .site-header__nav-row {
    border-bottom: 1px solid var(--color-border);
  }

  /* The header is persistent chrome, not page content — it stays
     full-bleed like the Home hero rather than settling into
     .container's new centered --content-width, which was making it
     narrow enough to wrap onto two lines. */
  .site-header__nav-inner {
    max-width: none;
    margin-inline: 0;
    padding-inline: clamp(var(--space-5), 8vw, 10rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: 0.6rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-shrink: 0;
    text-decoration: none;
    border-radius: var(--radius);
    transition: opacity 0.15s var(--ease-out);
  }

  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    opacity: 0.7;
  }

  .site-header__mark {
    display: block;
    height: 2.5rem;
    width: auto;
    /* the source image is a full wide eye shape — show it whole (no
       crop, no circle mask) instead of zooming into just the iris */
    object-fit: contain;
  }

  .site-header__wordmark {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .site-header__nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-block;
    padding-block: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .site-header__utility {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .site-header__date {
    display: none;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .site-header__cursor {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__cursor {
      animation: header-cursor-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes header-cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (min-width: 960px) {
    .site-header__date {
      display: block;
    }
  }

  .site-header__search {
    flex: 1 1 24rem;
    max-width: 28rem;
  }

  @media (max-width: 640px) {
    .site-header__search {
      max-width: none;
    }
  }
</style>
