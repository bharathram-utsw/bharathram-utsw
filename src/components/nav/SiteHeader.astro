---
import { withBase } from '../../lib/url';

const today = new Date()
  .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
  .toUpperCase();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/team', label: 'Team' },
  { href: '/publications', label: 'Publications' },
  { href: '/news', label: 'News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const based = withBase(href);
  if (href === '/') return currentPath === based;
  return currentPath === based || currentPath.startsWith(`${based}/`);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <a class="site-header__wordmark" href={withBase('/')}>
      <span class="mono site-header__mark">ML</span>
      <span class="site-header__name">Mondal Lab</span>
    </a>

    <p class="mono site-header__date" aria-hidden="true">{today} · DALLAS, TX</p>

    <!-- Mobile nav: the persistent index sidebar (SiteSidebar) hides below
         860px, so this is the only way to reach it on narrow viewports.
         Pure HTML/CSS, no JS. -->
    <details class="site-header__mobile">
      <summary aria-label="Open menu">
        <span class="mono">Menu</span>
      </summary>
      <nav aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 0.6rem;
  }

  .site-header__dots {
    display: none;
    gap: 0.35em;
  }

  .site-header__dots span {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    border: 1px solid var(--color-text-faint);
  }

  @media (min-width: 640px) {
    .site-header__dots {
      display: flex;
    }
  }

  .site-header__wordmark {
    display: flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6em;
    height: 1.6em;
    border: 1px solid var(--color-text);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .site-header__name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-header__date {
    display: none;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    margin-right: auto;
  }

  @media (min-width: 860px) {
    .site-header__date {
      display: block;
    }
  }

  @media (max-width: 859px) {
    .site-header__wordmark {
      margin-right: auto;
    }
  }

  .site-header__mobile {
    display: block;
  }

  @media (min-width: 860px) {
    .site-header__mobile {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .site-header__mobile {
      position: relative;
    }

    .site-header__mobile summary {
      list-style: none;
      cursor: pointer;
      font-size: var(--text-sm);
      padding: var(--space-1) 0;
      color: var(--color-text);
    }

    .site-header__mobile summary::-webkit-details-marker {
      display: none;
    }

    .site-header__mobile summary::before {
      content: '≡ ';
    }

    .site-header__mobile[open] summary::before {
      content: '✕ ';
    }

    .site-header__mobile nav {
      position: absolute;
      right: 0;
      top: calc(100% + var(--space-1));
      background: var(--color-bg-raised);
      border: 1px solid var(--color-border);
      min-width: 12rem;
      padding: var(--space-2);
      box-shadow: var(--shadow-card);
    }

    .site-header__mobile nav ul {
      display: flex;
      flex-direction: column;
      gap: 0;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-header__mobile nav a {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      text-decoration: none;
      padding: var(--space-2) var(--space-1);
      min-height: 44px;
      display: flex;
      align-items: center;
    }

    .site-header__mobile nav a[aria-current='page'] {
      color: var(--color-accent);
    }
  }
</style>
