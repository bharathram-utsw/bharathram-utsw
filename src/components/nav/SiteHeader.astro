---
// Single-row header: the eye mark and wordmark sit inline with the real
// nav links, all always visible — no click-to-reveal menu, and no
// separate banner row for the mark (both read as "not visible enough"
// before). The mark is shown in full (object-fit: contain, no crop) since
// cropping it into a circle was hiding the eye shape and leaving only the
// circuit-pattern iris.
import { withBase } from '../../lib/url';

// News and Gallery are one nav entry — Gallery's content now lives as a
// tab on the News page itself, so this link needs to read as "current"
// on both paths even though it only points at one of them.
const navItems = [
  { href: '/', label: 'Home', matchPaths: ['/'] },
  { href: '/research', label: 'Research', matchPaths: ['/research'] },
  { href: '/team', label: 'Team', matchPaths: ['/team'] },
  { href: '/publications', label: 'Publications', matchPaths: ['/publications'] },
  { href: '/news', label: 'News & Gallery', matchPaths: ['/news', '/gallery'] },
  { href: '/contact', label: 'Contact', matchPaths: ['/contact'] },
];

const currentPath = Astro.url.pathname;

function isActive(matchPaths: string[]) {
  return matchPaths.some((path) => {
    const based = withBase(path);
    if (path === '/') return currentPath === based;
    return currentPath === based || currentPath.startsWith(`${based}/`);
  });
}
---

<header class="site-header">
  <div class="site-header__nav-row">
    <div class="container site-header__nav-inner">
      <a class="site-header__brand" href={withBase('/')} aria-label="Mondal Lab — Home">
        <img src={withBase('/icon.png')} alt="" class="site-header__mark" />
        <span class="site-header__wordmark">Mondal Lab</span>
      </a>

      <nav class="site-header__nav" aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={withBase(item.href)} aria-current={isActive(item.matchPaths) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Fixed like SiteFooter's taskbar — persistent chrome that never
     scrolls away, not in-flow content. body reserves --header-height so
     nothing sits underneath it. */
  .site-header {
    background: var(--color-bg-raised);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
  }

  .site-header__nav-row {
    border-bottom: 1px solid var(--color-border);
  }

  /* The header is persistent chrome, not page content — it stays
     full-bleed like the Home hero rather than settling into
     .container's new centered --content-width, which was making it
     narrow enough to wrap onto two lines. */
  .site-header__nav-inner {
    max-width: none;
    margin-inline: 0;
    padding-inline: clamp(var(--space-5), 8vw, 10rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: 0.6rem;
    min-height: var(--header-height);
    box-sizing: border-box;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-shrink: 0;
    text-decoration: none;
    border-radius: var(--radius);
    transition: opacity 0.15s var(--ease-out);
  }

  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    opacity: 0.7;
  }

  .site-header__mark {
    display: block;
    height: 2.5rem;
    width: auto;
    /* the source image is a full wide eye shape — show it whole (no
       crop, no circle mask) instead of zooming into just the iris */
    object-fit: contain;
  }

  .site-header__wordmark {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .site-header__nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-block;
    padding-block: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
