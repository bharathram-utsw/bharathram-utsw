---
// A Sankey diagram of the lab's own conceptual model: multiple upstream
// causes (genetic, dietary, age-related, environmental) flow into a small
// set of shared molecular programs, which in turn flow into one of two
// outcomes. Same "hand-authored concept, real layout algorithm" treatment
// as the graph this replaces — the node/link *values* are illustrative
// (there's no dataset of "how much" each cause contributes; that's not a
// number that exists), but the Sankey layout itself — proportional node
// heights, stacked flow offsets — is computed for real from those values,
// not hand-drawn.
interface SankeyNode {
  id: string;
  label: string;
  column: 0 | 1 | 2;
  value: number;
}
interface SankeyLink {
  source: string;
  target: string;
  value: number;
}

const nodes: SankeyNode[] = [
  { id: 'genetic', label: 'Genetic mutations', column: 0, value: 10 },
  { id: 'diet', label: 'Diet & metabolism', column: 0, value: 8 },
  { id: 'aging', label: 'Aging', column: 0, value: 9 },
  { id: 'environment', label: 'Other environmental factors', column: 0, value: 5 },
  { id: 'photoreceptor', label: 'Photoreceptor degeneration program', column: 1, value: 7 },
  { id: 'metabolic', label: 'Metabolic dysregulation program', column: 1, value: 14 },
  { id: 'epigenetic', label: 'Epigenetic drift program', column: 1, value: 11 },
  { id: 'visionloss', label: 'Vision loss', column: 2, value: 15 },
  { id: 'recovery', label: 'Homeostatic recovery', column: 2, value: 17 },
];

const links: SankeyLink[] = [
  { source: 'genetic', target: 'photoreceptor', value: 7 },
  { source: 'genetic', target: 'metabolic', value: 3 },
  { source: 'diet', target: 'metabolic', value: 5 },
  { source: 'diet', target: 'epigenetic', value: 3 },
  { source: 'aging', target: 'epigenetic', value: 5 },
  { source: 'aging', target: 'metabolic', value: 4 },
  { source: 'environment', target: 'epigenetic', value: 3 },
  { source: 'environment', target: 'metabolic', value: 2 },
  { source: 'photoreceptor', target: 'visionloss', value: 5 },
  { source: 'photoreceptor', target: 'recovery', value: 2 },
  { source: 'metabolic', target: 'visionloss', value: 6 },
  { source: 'metabolic', target: 'recovery', value: 8 },
  { source: 'epigenetic', target: 'visionloss', value: 4 },
  { source: 'epigenetic', target: 'recovery', value: 7 },
];

interface LaidOutNode extends SankeyNode {
  yStart: number;
  yEnd: number;
  colorIndex: number;
}

const GAP_FRACTION = 0.1;
const nodesByColumn: LaidOutNode[][] = [[], [], []];
nodes.forEach((n, i) => nodesByColumn[n.column].push({ ...n, yStart: 0, yEnd: 0, colorIndex: i }));

for (const colNodes of nodesByColumn) {
  const total = colNodes.reduce((s, n) => s + n.value, 0);
  const gapEach = colNodes.length > 1 ? GAP_FRACTION / (colNodes.length - 1) : 0;
  const usable = 1 - GAP_FRACTION;
  let cursor = 0;
  for (const n of colNodes) {
    const h = (n.value / total) * usable;
    n.yStart = cursor;
    n.yEnd = cursor + h;
    cursor += h + gapEach;
  }
}

const nodeById = new Map<string, LaidOutNode>();
for (const col of nodesByColumn) for (const n of col) nodeById.set(n.id, n);

const outCursor = new Map<string, number>(nodes.map((n) => [n.id, 0]));
const inCursor = new Map<string, number>(nodes.map((n) => [n.id, 0]));

const laidOutLinks = links.map((link) => {
  const source = nodeById.get(link.source)!;
  const target = nodeById.get(link.target)!;

  const srcOffset = outCursor.get(link.source)!;
  const srcFracH = (link.value / source.value) * (source.yEnd - source.yStart);
  const sourceYStart = source.yStart + srcOffset;
  const sourceYEnd = sourceYStart + srcFracH;
  outCursor.set(link.source, srcOffset + srcFracH);

  const tgtOffset = inCursor.get(link.target)!;
  const tgtFracH = (link.value / target.value) * (target.yEnd - target.yStart);
  const targetYStart = target.yStart + tgtOffset;
  const targetYEnd = targetYStart + tgtFracH;
  inCursor.set(link.target, tgtOffset + tgtFracH);

  return {
    sourceColumn: source.column,
    targetColumn: target.column,
    sourceYStart,
    sourceYEnd,
    targetYStart,
    targetYEnd,
    value: link.value,
    colorIndex: source.colorIndex,
    sourceLabel: source.label,
    targetLabel: target.label,
  };
});

const laidOutNodes = nodesByColumn.flat().map((n) => ({
  id: n.id,
  label: n.label,
  column: n.column,
  value: n.value,
  yStart: n.yStart,
  yEnd: n.yEnd,
  colorIndex: n.colorIndex,
}));

const sankeyData = JSON.stringify({ nodes: laidOutNodes, links: laidOutLinks });
---

<div class="sankey">
  <div class="sankey__canvas-wrap">
    <canvas
      class="sankey__canvas"
      id="sankey-canvas"
      tabindex="0"
      role="img"
      aria-label="Sankey diagram: genetic, dietary, age-related, and environmental causes flow into a small set of shared molecular disease programs, which flow into either vision loss or homeostatic recovery"
    ></canvas>
    <script type="application/json" id="sankey-data" set:html={sankeyData} />
    <div class="sankey__tooltip" id="sankey-tooltip" hidden></div>
  </div>
  <p class="mono sankey__caption">
    Illustrative model, not measured proportions — hover a flow for what it represents.
  </p>
</div>

<style>
  .sankey {
    margin-bottom: var(--space-2);
  }

  .sankey__canvas-wrap {
    position: relative;
  }

  .sankey__canvas {
    display: block;
    width: 100%;
    height: 520px;
  }

  .sankey__caption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .sankey__tooltip {
    position: absolute;
    pointer-events: none;
    max-width: 22rem;
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    padding: 0.5em 0.75em;
    border-radius: var(--radius);
    transform: translate(-50%, calc(-100% - 10px));
    z-index: 2;
  }

  .sankey__tooltip strong {
    display: block;
    font-family: var(--font-sans);
    color: var(--color-accent-on-ink);
    margin-bottom: 0.2em;
  }

  @media (max-width: 640px) {
    .sankey__canvas {
      height: 640px;
    }
  }
</style>

<script>
  interface LaidOutNode {
    id: string;
    label: string;
    column: 0 | 1 | 2;
    value: number;
    yStart: number;
    yEnd: number;
    colorIndex: number;
  }
  interface LaidOutLink {
    sourceColumn: number;
    targetColumn: number;
    sourceYStart: number;
    sourceYEnd: number;
    targetYStart: number;
    targetYEnd: number;
    value: number;
    colorIndex: number;
    sourceLabel: string;
    targetLabel: string;
  }

  function readVar(name: string, fallback: string) {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  const canvas = document.getElementById('sankey-canvas') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('sankey-data');
  const tooltip = document.getElementById('sankey-tooltip');
  if (!canvas || !dataEl) throw new Error('ResearchSankey: missing canvas or data element');

  const raw = JSON.parse(dataEl.textContent || '{}') as { nodes: LaidOutNode[]; links: LaidOutLink[] };
  const ctx = canvas.getContext('2d');

  const PALETTE = ['#004c97', '#009ee2', '#f26531', '#e52334', '#00ab4e', '#776cb1', '#004c97', '#f26531', '#776cb1'];

  if (ctx && raw.nodes?.length > 0) {
    const textColor = readVar('--color-text', '#14181d');
    const mutedColor = readVar('--color-text-muted', '#4a5560');
    const monoFont = readVar('--font-mono', 'ui-monospace, monospace');
    const sansFont = readVar('--font-sans', 'sans-serif');

    const pad = 20;
    const barW = 14;
    const colHeaderH = 30;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function colX(column: number) {
      const innerW = width - pad * 2 - barW;
      return pad + barW / 2 + (column / 2) * innerW;
    }
    function toY(frac: number) {
      return pad + colHeaderH + frac * (height - pad * 2 - colHeaderH);
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    type NodeHit = { x: number; y: number; w: number; h: number; node: LaidOutNode };
    type LinkHit = { link: LaidOutLink; sample: { x: number; yTop: number; yBot: number }[] };
    let nodeHits: NodeHit[] = [];
    let linkHits: LinkHit[] = [];
    let hoveredNode: LaidOutNode | null = null;
    let hoveredLink: LaidOutLink | null = null;

    function drawLink(l: LaidOutLink, isHot: boolean) {
      const x0 = colX(l.sourceColumn) + barW / 2;
      const x1 = colX(l.targetColumn) - barW / 2;
      const y0top = toY(l.sourceYStart);
      const y0bot = toY(l.sourceYEnd);
      const y1top = toY(l.targetYStart);
      const y1bot = toY(l.targetYEnd);
      const cx = (x0 + x1) / 2;

      ctx!.beginPath();
      ctx!.moveTo(x0, y0top);
      ctx!.bezierCurveTo(cx, y0top, cx, y1top, x1, y1top);
      ctx!.lineTo(x1, y1bot);
      ctx!.bezierCurveTo(cx, y1bot, cx, y0bot, x0, y0bot);
      ctx!.closePath();
      ctx!.fillStyle = PALETTE[l.colorIndex % PALETTE.length];
      ctx!.globalAlpha = isHot ? 0.55 : 0.24;
      ctx!.fill();
      ctx!.globalAlpha = 1;

      linkHits.push({
        link: l,
        sample: [
          { x: x0, yTop: y0top, yBot: y0bot },
          { x: cx, yTop: (y0top + y1top) / 2, yBot: (y0bot + y1bot) / 2 },
          { x: x1, yTop: y1top, yBot: y1bot },
        ],
      });
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);
      nodeHits = [];
      linkHits = [];

      ctx!.font = `600 10px ${monoFont}`;
      ctx!.fillStyle = mutedColor;
      ctx!.textAlign = 'left';
      ctx!.fillText('CAUSES', colX(0) - barW / 2, pad + 14);
      ctx!.textAlign = 'center';
      ctx!.fillText('SHARED PROGRAMS', colX(1), pad + 14);
      ctx!.textAlign = 'right';
      ctx!.fillText('OUTCOMES', colX(2) + barW / 2, pad + 14);

      for (const l of raw.links) {
        const connectedToHoveredNode =
          hoveredNode !== null && (l.sourceLabel === hoveredNode.label || l.targetLabel === hoveredNode.label);
        drawLink(l, hoveredLink === l || connectedToHoveredNode);
      }

      for (const n of raw.nodes) {
        const x = colX(n.column) - barW / 2;
        const yTop = toY(n.yStart);
        const yBot = toY(n.yEnd);
        const isHot = hoveredNode === n;
        ctx!.fillStyle = PALETTE[n.colorIndex % PALETTE.length];
        ctx!.globalAlpha = isHot ? 1 : 0.88;
        ctx!.fillRect(x, yTop, barW, Math.max(yBot - yTop, 2));
        ctx!.globalAlpha = 1;

        const label = n.label.length > 30 ? `${n.label.slice(0, 28)}…` : n.label;
        ctx!.font = `${isHot ? '600 ' : ''}10px ${sansFont}`;
        ctx!.fillStyle = isHot ? textColor : mutedColor;
        const midY = (yTop + yBot) / 2;
        if (n.column === 0) {
          ctx!.textAlign = 'left';
          ctx!.fillText(label, x + barW + 8, midY);
        } else if (n.column === 2) {
          ctx!.textAlign = 'right';
          ctx!.fillText(label, x - 8, midY);
        } else {
          ctx!.textAlign = 'center';
          ctx!.fillText(label, x + barW / 2, yTop - 8);
        }

        nodeHits.push({ x, y: yTop, w: barW, h: Math.max(yBot - yTop, 2), node: n });
      }
    }

    function nodeAt(x: number, y: number): LaidOutNode | null {
      for (const h of nodeHits) {
        if (x >= h.x - 4 && x <= h.x + h.w + 4 && y >= h.y && y <= h.y + h.h) return h.node;
      }
      return null;
    }

    function linkAt(x: number, y: number): LaidOutLink | null {
      for (const h of linkHits) {
        for (let i = 0; i < h.sample.length - 1; i++) {
          const a = h.sample[i];
          const b = h.sample[i + 1];
          if (x < Math.min(a.x, b.x) || x > Math.max(a.x, b.x)) continue;
          const t = (x - a.x) / (b.x - a.x || 1);
          const yTop = a.yTop + (b.yTop - a.yTop) * t;
          const yBot = a.yBot + (b.yBot - a.yBot) * t;
          if (y >= yTop && y <= yBot) return h.link;
        }
      }
      return null;
    }

    function pointerPos(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    canvas.addEventListener('pointermove', (e) => {
      const pos = pointerPos(e);
      const n = nodeAt(pos.x, pos.y);
      const l = n ? null : linkAt(pos.x, pos.y);
      hoveredNode = n;
      hoveredLink = l;
      if ((n || l) && tooltip) {
        tooltip.hidden = false;
        tooltip.style.left = `${pos.x}px`;
        tooltip.style.top = `${pos.y}px`;
        if (n) {
          tooltip.innerHTML = `<strong>${n.label}</strong>${n.value} share${n.value === 1 ? '' : 's'} of total flow`;
        } else if (l) {
          tooltip.innerHTML = `<strong>${l.sourceLabel} → ${l.targetLabel}</strong>${l.value} share${l.value === 1 ? '' : 's'}`;
        }
      } else if (tooltip) {
        tooltip.hidden = true;
      }
      draw();
    });
    canvas.addEventListener('pointerleave', () => {
      hoveredNode = null;
      hoveredLink = null;
      if (tooltip) tooltip.hidden = true;
      draw();
    });

    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => {
        resize();
        draw();
      });
      ro.observe(canvas);
    } else {
      resize();
      draw();
      window.addEventListener('resize', () => {
        resize();
        draw();
      });
    }
  }
</script>
