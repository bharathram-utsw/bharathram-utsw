---
// An interactive topic network: one node per keyword, sized by how many
// publications carry it; edges connect topics that co-occur on the same
// paper. Drag nodes around, or click one (or several) to filter the card
// grid below — the same real keyword data that drives the Home hero, reused
// here as both art and navigation.
//
// Scoped to the vision-era publication record (see src/lib/publications.ts)
// — the PI's earlier microbial/genomics-era PhD work isn't the lab's
// current focus, so it's excluded here even though it's still fully listed
// (and still filterable-away, once a vision topic is selected) in the
// publications grid below.
import { getCollection } from 'astro:content';
import { isVisionEra } from '../lib/publications';

const pubs = (await getCollection('publications')).filter((p) => isVisionEra(p.data.keywords));
const counts = new Map<string, number>();
for (const pub of pubs) {
  for (const kw of pub.data.keywords) {
    counts.set(kw, (counts.get(kw) ?? 0) + 1);
  }
}

const edgeWeights = new Map<string, number>();
for (const pub of pubs) {
  const kws = pub.data.keywords;
  for (let i = 0; i < kws.length; i++) {
    for (let j = i + 1; j < kws.length; j++) {
      const key = [kws[i], kws[j]].sort().join('|');
      edgeWeights.set(key, (edgeWeights.get(key) ?? 0) + 1);
    }
  }
}

const TOP_N = 34;
const topKeywords = new Set(
  [...counts.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, TOP_N)
    .map(([label]) => label),
);

const topics = [...counts.entries()]
  .filter(([label]) => topKeywords.has(label))
  .map(([label, count]) => ({ label, count }));
const edges = [...edgeWeights.entries()]
  .map(([key, weight]) => {
    const [a, b] = key.split('|');
    return { a, b, weight };
  })
  .filter((e) => topKeywords.has(e.a) && topKeywords.has(e.b));
const graphData = JSON.stringify({ nodes: topics, edges });
---

<div class="pub-network-layout">
  <div class="pub-network-layout__text">
    <span class="eyebrow">By topic</span>
    <h2>How the topics connect</h2>
    <p class="mono pub-network-layout__caption">Click a topic to filter. Drag to rearrange.</p>
  </div>

  <div class="pub-network">
    <div class="pub-network__canvas-wrap">
      <canvas
        class="pub-network__canvas"
        id="pub-network-canvas"
        tabindex="0"
        role="group"
        aria-label="Interactive topic network — drag a node, or click to filter publications below"
      ></canvas>
      <div class="pub-network__tooltip" id="pub-network-tooltip" hidden></div>
      <script type="application/json" id="pub-network-data" set:html={graphData} />
    </div>
    <div class="pub-network__active" id="pub-network-active" hidden>
      <span class="mono">Filtered by:</span>
      <span id="pub-network-active-list"></span>
      <button type="button" class="mono pub-network__clear" id="pub-network-clear">Clear ×</button>
    </div>
    <noscript>
      <p class="mono pub-network__noscript">JavaScript is off — showing every publication below, unfiltered.</p>
    </noscript>
  </div>
</div>

<style>
  .pub-network-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 22rem) 1fr;
    gap: var(--space-5);
    align-items: center;
    margin-bottom: var(--space-5);
  }

  .pub-network-layout__caption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  @media (max-width: 900px) {
    .pub-network-layout {
      grid-template-columns: 1fr;
    }
  }

  .pub-network__canvas-wrap {
    position: relative;
    overflow: hidden;
  }

  .pub-network__canvas {
    display: block;
    width: 100%;
    height: 600px;
    touch-action: none;
    cursor: grab;
  }

  .pub-network__canvas:active {
    cursor: grabbing;
  }

  .pub-network__tooltip {
    position: absolute;
    pointer-events: none;
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    padding: 0.5em 0.75em;
    border-radius: var(--radius);
    transform: translate(-50%, calc(-100% - 10px));
    z-index: 2;
    white-space: nowrap;
  }

  .pub-network__active {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pub-network__active[hidden] {
    display: none;
  }

  .pub-network__clear {
    border: 1px solid var(--color-border-strong);
    background: none;
    padding: 0.2em 0.6em;
    border-radius: var(--radius);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .pub-network__clear:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }

  .pub-network__noscript {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-2);
  }

  @media (max-width: 640px) {
    .pub-network__canvas {
      height: 420px;
    }
  }
</style>

<script>
  interface Node {
    label: string;
    count: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    colorIndex: number;
  }

  function readVar(name: string, fallback: string) {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  const canvas = document.getElementById('pub-network-canvas') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('pub-network-data');
  const tooltip = document.getElementById('pub-network-tooltip');
  const activeBar = document.getElementById('pub-network-active');
  const activeList = document.getElementById('pub-network-active-list');
  const clearBtn = document.getElementById('pub-network-clear');
  if (!canvas || !dataEl) throw new Error('PublicationNetwork: missing canvas or data element');

  const raw = JSON.parse(dataEl.textContent || '{"nodes":[],"edges":[]}') as {
    nodes: { label: string; count: number }[];
    edges: { a: string; b: string; weight: number }[];
  };
  const ctx = canvas.getContext('2d');

  const PALETTE = ['#004c97', '#009ee2', '#f26531', '#e52334', '#00ab4e', '#776cb1'];
  const activeFilters = new Set<string>();

  function applyFilters() {
    const cards = document.querySelectorAll<HTMLElement>('[data-pub-card]');
    for (const card of cards) {
      const kws = (card.dataset.keywords ?? '').split('|');
      const matches = activeFilters.size === 0 || kws.some((k) => activeFilters.has(k));
      card.dataset.dimmed = matches ? 'false' : 'true';
    }
    if (activeBar && activeList) {
      if (activeFilters.size === 0) {
        activeBar.hidden = true;
      } else {
        activeBar.hidden = false;
        activeList.textContent = [...activeFilters].join(', ');
      }
    }
    document.dispatchEvent(new CustomEvent('pub-filter-change'));
  }

  if (ctx && raw.nodes.length > 0) {
    const labelColor = readVar('--color-text', '#14181d');
    const edgeColor = readVar('--color-border-strong', '#b9c5d1');
    const monoFont = readVar('--font-mono', 'ui-monospace, monospace');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const nodes: Node[] = raw.nodes.map((n, i) => ({
      ...n,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      r: 0,
      colorIndex: i % PALETTE.length,
    }));
    const byLabel = new Map(nodes.map((n) => [n.label, n]));
    const edges = raw.edges
      .map((e) => [byLabel.get(e.a), byLabel.get(e.b), e.weight] as const)
      .filter((e): e is [Node, Node, number] => !!e[0] && !!e[1]);

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function sizeNodes() {
      const maxCount = Math.max(...nodes.map((n) => n.count));
      const minR = Math.min(width, height) * 0.024;
      const maxR = Math.min(width, height) * 0.052;
      for (const n of nodes) {
        n.r = minR + (n.count / maxCount) * (maxR - minR);
      }
    }

    function layoutInitial() {
      const cx = width / 2;
      const cy = height / 2;
      const radius = Math.min(width, height) * 0.4;
      nodes.forEach((n, i) => {
        const angle = (i / nodes.length) * Math.PI * 2;
        n.x = cx + Math.cos(angle) * radius * (0.4 + Math.random() * 0.6);
        n.y = cy + Math.sin(angle) * radius * (0.4 + Math.random() * 0.6);
        n.vx = 0;
        n.vy = 0;
      });
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      sizeNodes();
      layoutInitial();
    }

    let dragging: Node | null = null;
    let hovered: Node | null = null;
    let pointerDownAt: { x: number; y: number } | null = null;
    let didDrag = false;

    function step() {
      const cx = width / 2;
      const cy = height / 2;
      for (const n of nodes) {
        if (n === dragging) continue;
        let fx = (cx - n.x) * 0.0018;
        let fy = (cy - n.y) * 0.0018;
        for (const other of nodes) {
          if (other === n) continue;
          const dx = n.x - other.x;
          const dy = n.y - other.y;
          const distSq = Math.max(dx * dx + dy * dy, 200);
          const force = 2200 / distSq;
          fx += (dx / Math.sqrt(distSq)) * force;
          fy += (dy / Math.sqrt(distSq)) * force;
        }
        n.vx = (n.vx + fx) * 0.86;
        n.vy = (n.vy + fy) * 0.86;
      }
      const REST = 118;
      for (const [a, b, weight] of edges) {
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.max(Math.sqrt(dx * dx + dy * dy), 1);
        const diff = (dist - REST) * 0.012 * Math.min(weight, 3);
        const nx = dx / dist;
        const ny = dy / dist;
        if (a !== dragging) {
          a.vx += nx * diff;
          a.vy += ny * diff;
        }
        if (b !== dragging) {
          b.vx -= nx * diff;
          b.vy -= ny * diff;
        }
      }
      for (const n of nodes) {
        if (n === dragging) continue;
        n.x += n.vx;
        n.y += n.vy;
        n.x = Math.min(Math.max(n.x, n.r + 4), width - n.r - 4);
        n.y = Math.min(Math.max(n.y, n.r + 4), height - n.r - 4);
      }
    }

    // Every label sits below its node at a fixed offset, then this pass
    // nudges any that collide (by measured text width) further down until
    // clear — recomputed only after the layout settles, not every frame,
    // since a stationary graph only needs it done once.
    type LabelPos = { x: number; y: number; w: number };
    const labelPos = new Map<Node, LabelPos>();
    function computeLabelLayout() {
      labelPos.clear();
      ctx!.font = `10px ${monoFont}`;
      const h = 13;
      const placed: { x: number; y: number; w: number; h: number }[] = [];
      const byTopY = [...nodes].sort((a, b) => a.y - b.y);
      for (const n of byTopY) {
        const text = n.label.length > 20 ? `${n.label.slice(0, 18)}…` : n.label;
        const w = ctx!.measureText(text).width + 8;
        let y = n.y + n.r + 13;
        let guard = 0;
        while (
          guard++ < 8 &&
          placed.some((p) => Math.abs(p.x - n.x) < (p.w + w) / 2 && Math.abs(p.y - y) < (p.h + h) / 2)
        ) {
          y += h + 2;
        }
        const box = { x: n.x, y, w, h };
        placed.push(box);
        labelPos.set(n, { x: n.x, y, w });
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      for (const [a, b, weight] of edges) {
        const near = hovered && (hovered === a || hovered === b);
        ctx!.strokeStyle = near ? PALETTE[a.colorIndex] : edgeColor;
        ctx!.lineWidth = near ? 2.25 : Math.min(1.1 + weight * 0.35, 2.6);
        ctx!.globalAlpha = near ? 0.85 : 0.55;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;

      for (const n of nodes) {
        const active = activeFilters.has(n.label);
        const isHot = n === hovered || n === dragging;
        const color = PALETTE[n.colorIndex];

        // Soft glow behind every node — same touch as the Research page graph.
        ctx!.beginPath();
        ctx!.fillStyle = color;
        ctx!.globalAlpha = active || isHot ? 0.25 : 0.14;
        ctx!.arc(n.x, n.y, n.r + (active || isHot ? 9 : 6), 0, Math.PI * 2);
        ctx!.fill();

        ctx!.beginPath();
        ctx!.fillStyle = color;
        ctx!.globalAlpha = active ? 0.95 : isHot ? 0.85 : 0.7;
        ctx!.arc(n.x, n.y, isHot ? n.r * 1.08 : n.r, 0, Math.PI * 2);
        ctx!.fill();
        if (active) {
          ctx!.lineWidth = 2;
          ctx!.strokeStyle = color;
          ctx!.globalAlpha = 1;
          ctx!.stroke();
        }
        ctx!.globalAlpha = 1;
      }

      // Labels drawn as a separate pass, on top of every node/edge, so a
      // label is never partially hidden behind a neighboring node.
      ctx!.font = `10px ${monoFont}`;
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';
      for (const n of nodes) {
        const pos = labelPos.get(n);
        if (!pos) continue;
        const active = activeFilters.has(n.label);
        const isHot = n === hovered || n === dragging;
        const text = n.label.length > 20 ? `${n.label.slice(0, 18)}…` : n.label;
        ctx!.font = `${isHot || active ? '600 ' : ''}10px ${monoFont}`;
        // A soft halo behind the text keeps it legible over the now-
        // transparent canvas background, regardless of what's behind it.
        ctx!.lineWidth = 3;
        ctx!.strokeStyle = readVar('--color-bg', '#fbfaf8');
        ctx!.globalAlpha = 0.9;
        ctx!.strokeText(text, pos.x, pos.y);
        ctx!.globalAlpha = 1;
        ctx!.fillStyle = isHot || active ? readVar('--color-text', '#14181d') : labelColor;
        ctx!.fillText(text, pos.x, pos.y);
      }
    }

    function nodeAt(x: number, y: number) {
      return nodes.find((n) => Math.hypot(n.x - x, n.y - y) <= n.r + 3);
    }

    function pointerPos(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    function showTooltip(n: Node, clientX: number, clientY: number) {
      if (!tooltip) return;
      const rect = canvas!.getBoundingClientRect();
      tooltip.hidden = false;
      tooltip.style.left = `${clientX - rect.left}px`;
      tooltip.style.top = `${clientY - rect.top - n.r}px`;
      tooltip.textContent = `${n.label} — ${n.count} paper${n.count === 1 ? '' : 's'}`;
    }

    canvas.addEventListener('pointerdown', (e) => {
      const p = pointerPos(e);
      const hit = nodeAt(p.x, p.y);
      pointerDownAt = p;
      didDrag = false;
      if (hit) {
        dragging = hit;
        canvas!.setPointerCapture(e.pointerId);
      }
    });

    canvas.addEventListener('pointermove', (e) => {
      const p = pointerPos(e);
      if (dragging && pointerDownAt) {
        if (Math.hypot(p.x - pointerDownAt.x, p.y - pointerDownAt.y) > 4) didDrag = true;
        dragging.x = Math.min(Math.max(p.x, dragging.r + 4), width - dragging.r - 4);
        dragging.y = Math.min(Math.max(p.y, dragging.r + 4), height - dragging.r - 4);
        showTooltip(dragging, e.clientX, e.clientY);
        // The graph is otherwise stationary — only nudge neighbors while a
        // node is actively being dragged, for a live feel without any
        // perpetual idle animation.
        if (!reducedMotion) for (let i = 0; i < 3; i++) step();
        draw();
        return;
      }
      const hit = nodeAt(p.x, p.y);
      hovered = hit ?? null;
      canvas!.style.cursor = hit ? 'grab' : 'default';
      if (hit) showTooltip(hit, e.clientX, e.clientY);
      else if (tooltip) tooltip.hidden = true;
      draw();
    });

    function endDrag(e: PointerEvent) {
      if (dragging) {
        canvas!.releasePointerCapture(e.pointerId);
        if (!didDrag) {
          if (activeFilters.has(dragging.label)) activeFilters.delete(dragging.label);
          else activeFilters.add(dragging.label);
          applyFilters();
        }
        dragging = null;
        if (!reducedMotion) for (let i = 0; i < 120; i++) step();
        computeLabelLayout();
        draw();
      }
      pointerDownAt = null;
    }
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointerleave', (e) => {
      endDrag(e);
      hovered = null;
      if (tooltip) tooltip.hidden = true;
      draw();
    });

    function settleAndDraw() {
      for (let i = 0; i < 260; i++) step();
      computeLabelLayout();
      draw();
    }

    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => {
        resize();
        settleAndDraw();
      });
      ro.observe(canvas);
    } else {
      window.addEventListener('resize', () => {
        resize();
        settleAndDraw();
      });
    }

    clearBtn?.addEventListener('click', () => {
      activeFilters.clear();
      applyFilters();
      draw();
    });

    resize();
    settleAndDraw();
  }
</script>
