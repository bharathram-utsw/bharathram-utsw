---
// A decorative, hand-drawn-style map illustration — not a literal, accurate
// street map (the real Google Maps link next to it handles actual
// navigation). Compass rose, dashed cartographer's frame, abstract road
// linework, in the site's own ink/blue/orange palette rather than sepia, so
// it reads as "this lab's illustration" rather than a generic vintage stock
// image. Pure static SVG, no JS.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['vintage-map', className]}
  viewBox="0 0 480 320"
  role="img"
  aria-label="Illustrated map marking the Mondal Lab's location at UT Southwestern Medical Center, Dallas, Texas"
>
  <rect x="0" y="0" width="480" height="320" class="vintage-map__bg" />

  <!-- cartographer's frame -->
  <rect x="10" y="10" width="460" height="300" class="vintage-map__frame" />
  <rect x="16" y="16" width="448" height="288" class="vintage-map__frame-inner" />

  <!-- abstract road network, decorative not literal -->
  <g class="vintage-map__roads">
    <path d="M 20 240 Q 120 210 180 235 T 320 220 Q 380 210 460 230" />
    <path d="M 40 60 Q 90 130 140 150 T 240 190 Q 300 230 340 280" />
    <path d="M 300 30 Q 280 90 240 120 T 200 190" />
    <path d="M 380 40 Q 340 100 350 160 T 300 260" />
    <path d="M 60 300 Q 80 220 60 160 T 90 40" />
  </g>

  <!-- scattered abstract city blocks -->
  <g class="vintage-map__blocks">
    <rect x="70" y="90" width="18" height="14" />
    <rect x="100" y="70" width="14" height="20" />
    <rect x="330" y="70" width="20" height="16" />
    <rect x="360" y="100" width="16" height="16" />
    <rect x="90" y="200" width="22" height="14" />
    <rect x="360" y="200" width="18" height="18" />
    <rect x="150" y="240" width="16" height="12" />
  </g>

  <!-- compass rose -->
  <g class="vintage-map__compass" transform="translate(408, 64)">
    <circle r="34" class="vintage-map__compass-ring" />
    <path d="M 0 -30 L 6 0 L 0 30 L -6 0 Z" class="vintage-map__compass-needle" />
    <path d="M -30 0 L 0 6 L 30 0 L 0 -6 Z" class="vintage-map__compass-needle vintage-map__compass-needle--soft" />
    <text y="-40" class="mono vintage-map__compass-label">N</text>
  </g>

  <!-- the pin -->
  <g transform="translate(220, 160)">
    <circle r="10" class="vintage-map__pin-halo" />
    <path
      d="M0 -22 C 12 -22 20 -13 20 -2 C 20 12 0 30 0 30 C 0 30 -20 12 -20 -2 C -20 -13 -12 -22 0 -22 Z"
      class="vintage-map__pin"
    />
    <circle r="5" cy="-2" class="vintage-map__pin-dot" />
  </g>

  <!-- label cartouche -->
  <g transform="translate(240, 205)">
    <text text-anchor="middle" class="vintage-map__label-title">Mondal Lab</text>
    <text text-anchor="middle" y="16" class="mono vintage-map__label-sub">UT Southwestern · Dallas, TX</text>
  </g>

  <!-- scale bar, classic map ornament -->
  <g transform="translate(32, 288)" class="mono vintage-map__scale">
    <line x1="0" y1="0" x2="48" y2="0" />
    <line x1="0" y1="-4" x2="0" y2="4" />
    <line x1="48" y1="-4" x2="48" y2="4" />
    <text x="24" y="16" text-anchor="middle">~1 MI</text>
  </g>
</svg>

<style>
  .vintage-map {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .vintage-map__bg {
    fill: #f6f1e6;
  }

  .vintage-map__frame {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 2;
  }

  .vintage-map__frame-inner {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0.6;
  }

  .vintage-map__roads {
    fill: none;
    stroke: #8a7a5c;
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .vintage-map__blocks {
    fill: #8a7a5c;
    opacity: 0.18;
  }

  .vintage-map__compass-ring {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 1;
    opacity: 0.5;
  }

  .vintage-map__compass-needle {
    fill: var(--color-accent-strong);
  }

  .vintage-map__compass-needle--soft {
    fill: #8a7a5c;
    opacity: 0.6;
  }

  .vintage-map__compass-label {
    font-size: 11px;
    fill: var(--color-accent-strong);
    text-anchor: middle;
  }

  .vintage-map__pin-halo {
    fill: var(--color-accent-2);
    opacity: 0.18;
  }

  .vintage-map__pin {
    fill: var(--color-accent-2);
    stroke: #f6f1e6;
    stroke-width: 1.5;
  }

  .vintage-map__pin-dot {
    fill: #f6f1e6;
  }

  .vintage-map__label-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    fill: var(--color-accent-strong);
  }

  .vintage-map__label-sub {
    font-size: 10px;
    fill: #6b5f47;
    letter-spacing: 0.02em;
  }

  .vintage-map__scale {
    stroke: #6b5f47;
    stroke-width: 1;
    fill: #6b5f47;
  }

  .vintage-map__scale text {
    stroke: none;
    font-size: 9px;
  }
</style>
