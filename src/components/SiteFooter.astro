---
// A persistent taskbar, not an in-flow footer — fixed to the viewport
// bottom on every page, the way a Windows-style taskbar never scrolls
// away, so page length never determines when it shows up. Nav now lives
// in the header's icon menu (see SiteHeader.astro), so this is just the
// system-tray clock — the one piece of taskbar chrome that's genuinely its
// own thing, not a duplicate of nav that already lives elsewhere.
---

<footer class="taskbar">
  <div class="taskbar__tray">
    <span class="mono taskbar__clock" id="taskbar-clock" aria-hidden="true"></span>
  </div>
</footer>

<style>
  .taskbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    height: var(--taskbar-height);
    background: var(--color-bg-raised);
    border-top: 1px solid var(--color-border);
  }

  .taskbar__tray {
    display: flex;
    align-items: center;
    padding-inline: var(--space-3);
    border-left: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>

<script>
  const clockEl = document.getElementById('taskbar-clock');

  function updateClock() {
    if (!clockEl) return;
    clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
  }

  updateClock();
  setInterval(updateClock, 15000);
</script>
