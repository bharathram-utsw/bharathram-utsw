---
// A real PCA plot: every publication's keyword list becomes a binary
// presence vector (papers × unique keywords), and we run actual principal
// component analysis on that matrix — the same class of dimensionality-
// reduction technique used on real omics data in the lab's own research.
// Papers sharing more keywords land closer together. Computed once at
// build time (dual/Gram-matrix PCA — correct and efficient here since
// there are far more keywords than papers); the client only draws.
//
// Scoped to the vision-era publication record only (see
// src/lib/publications.ts) — the PI's earlier microbial/genomics-era PhD
// work isn't the lab's current focus, so it's excluded from this plot even
// though it's still fully listed in the publications grid below.
import { getCollection } from 'astro:content';
import { isVisionEra } from '../lib/publications';

const pubs = (await getCollection('publications'))
  .filter((p) => isVisionEra(p.data.keywords))
  .sort((a, b) => b.data.year - a.data.year);
const keywords = [...new Set(pubs.flatMap((p) => p.data.keywords))];
const n = pubs.length;

const X = pubs.map((pub) => keywords.map((kw) => (pub.data.keywords.includes(kw) ? 1 : 0)));
const colMeans = keywords.map((_, j) => X.reduce((s, row) => s + row[j], 0) / n);
const Xc = X.map((row) => row.map((v, j) => v - colMeans[j]));

function gram(A: number[][]): number[][] {
  const G: number[][] = Array.from({ length: A.length }, () => new Array(A.length).fill(0));
  for (let i = 0; i < A.length; i++) {
    for (let k = i; k < A.length; k++) {
      let s = 0;
      for (let j = 0; j < A[i].length; j++) s += A[i][j] * A[k][j];
      G[i][k] = s;
      G[k][i] = s;
    }
  }
  return G;
}

function matVec(M: number[][], v: number[]): number[] {
  return M.map((row) => row.reduce((s, val, j) => s + val * v[j], 0));
}

function norm(v: number[]): number {
  return Math.sqrt(v.reduce((s, x) => s + x * x, 0)) || 1;
}

// Deterministic seed (not Math.random) so the layout is stable across
// rebuilds — the plot shouldn't shuffle itself every time content changes.
function powerIteration(M: number[][], iterations = 400) {
  let v = M.map((_, i) => Math.sin(i * 1.37 + 1));
  for (let iter = 0; iter < iterations; iter++) {
    v = matVec(M, v).map((x) => x / norm(matVec(M, v)));
  }
  const Mv = matVec(M, v);
  const eigenvalue = v.reduce((s, x, i) => s + x * Mv[i], 0);
  return { vector: v, eigenvalue: Math.max(eigenvalue, 0) };
}

const G = gram(Xc);
const { vector: v1, eigenvalue: lambda1 } = powerIteration(G);
const G2 = G.map((row, i) => row.map((val, k) => val - lambda1 * v1[i] * v1[k]));
const { vector: v2, eigenvalue: lambda2 } = powerIteration(G2);

const pc1 = v1.map((x) => x * Math.sqrt(lambda1));
const pc2 = v2.map((x) => x * Math.sqrt(lambda2));
const totalVariance = G.reduce((s, row, i) => s + row[i], 0) || 1;
const pc1Pct = Math.round((lambda1 / totalVariance) * 100);
const pc2Pct = Math.round((lambda2 / totalVariance) * 100);

const points = pubs.map((pub, i) => ({
  id: pub.id,
  title: pub.data.title,
  year: pub.data.year,
  journal: pub.data.journal,
  x: pc1[i],
  y: pc2[i],
}));
const plotData = JSON.stringify({ points, pc1Pct, pc2Pct });
---

<div class="pca">
  <div class="pca__text">
    <span class="eyebrow">By similarity</span>
    <h2>Mapped by keyword — a real PCA</h2>
    <p class="prose pca__copy">
      Every paper's keyword list becomes a vector; principal component analysis projects that
      onto two axes. Papers sharing more keywords land closer together — no manual grouping,
      just the actual overlap in what each paper is about. Scoped to the lab's retina and vision
      research; earlier PhD-era work in microbial genomics is still in the full list below.
    </p>
    <p class="mono pca__caption">Click a point to jump to it below.</p>
  </div>

  <div class="pca__canvas-wrap">
    <canvas class="pca__canvas" id="pca-canvas" tabindex="0" role="img"
      aria-label="Principal component analysis plot of the lab's retina and vision publications, grouped by keyword similarity"
    ></canvas>
    <script type="application/json" id="pca-data" set:html={plotData} />
    <div class="pca__tooltip" id="pca-tooltip" hidden></div>
  </div>
</div>

<style>
  .pca {
    display: grid;
    grid-template-columns: minmax(16rem, 22rem) 1fr;
    gap: var(--space-5);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .pca__copy {
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    max-width: 40ch;
  }

  .pca__caption {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .pca__canvas-wrap {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    overflow: hidden;
  }

  .pca__canvas {
    display: block;
    width: 100%;
    height: 460px;
    cursor: pointer;
  }

  .pca__tooltip {
    position: absolute;
    pointer-events: none;
    max-width: 20rem;
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    padding: 0.5em 0.75em;
    border-radius: var(--radius);
    transform: translate(-50%, calc(-100% - 10px));
    z-index: 2;
  }

  .pca__tooltip strong {
    display: block;
    font-family: var(--font-sans);
    color: var(--color-accent-on-ink);
    margin-bottom: 0.2em;
  }

  @media (max-width: 900px) {
    .pca {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .pca__canvas {
      height: 360px;
    }
  }
</style>

<script>
  interface Point {
    id: string;
    title: string;
    year: number;
    journal: string;
    x: number;
    y: number;
    px: number;
    py: number;
  }

  function readVar(name: string, fallback: string) {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  // Andrew's monotone chain convex hull, in screen-pixel space (post-layout,
  // so the same routine works regardless of data scale).
  function convexHull(pts: { px: number; py: number }[]): { px: number; py: number }[] {
    if (pts.length < 3) return pts;
    const sorted = [...pts].sort((a, b) => a.px - b.px || a.py - b.py);
    const cross = (o: any, a: any, b: any) => (a.px - o.px) * (b.py - o.py) - (a.py - o.py) * (b.px - o.px);
    const lower: typeof sorted = [];
    for (const p of sorted) {
      while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) lower.pop();
      lower.push(p);
    }
    const upper: typeof sorted = [];
    for (let i = sorted.length - 1; i >= 0; i--) {
      const p = sorted[i];
      while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) upper.pop();
      upper.push(p);
    }
    lower.pop();
    upper.pop();
    return lower.concat(upper);
  }

  function inflateHull(hull: { px: number; py: number }[], amount: number) {
    const cx = hull.reduce((s, p) => s + p.px, 0) / hull.length;
    const cy = hull.reduce((s, p) => s + p.py, 0) / hull.length;
    return hull.map((p) => {
      const dx = p.px - cx;
      const dy = p.py - cy;
      const d = Math.hypot(dx, dy) || 1;
      return { px: p.px + (dx / d) * amount, py: p.py + (dy / d) * amount };
    });
  }

  function smoothClosedPath(ctx: CanvasRenderingContext2D, pts: { px: number; py: number }[]) {
    if (pts.length < 3) return;
    const loop = [...pts, pts[0], pts[1]];
    ctx.moveTo((loop[0].px + loop[loop.length - 1].px) / 2, (loop[0].py + loop[loop.length - 1].py) / 2);
    for (let i = 0; i < loop.length - 1; i++) {
      const mx = (loop[i].px + loop[i + 1].px) / 2;
      const my = (loop[i].py + loop[i + 1].py) / 2;
      ctx.quadraticCurveTo(loop[i].px, loop[i].py, mx, my);
    }
  }

  const canvas = document.getElementById('pca-canvas') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('pca-data');
  const tooltip = document.getElementById('pca-tooltip');
  if (!canvas || !dataEl) throw new Error('PublicationPCA: missing canvas or data element');

  const raw = JSON.parse(dataEl.textContent || '{}') as {
    points: { id: string; title: string; year: number; journal: string; x: number; y: number }[];
    pc1Pct: number;
    pc2Pct: number;
  };
  const ctx = canvas.getContext('2d');

  if (ctx && raw.points?.length > 0) {
    const axisColor = readVar('--color-border-strong', '#b9c5d1');
    const gridColor = readVar('--color-border', '#dce3ea');
    const textColor = readVar('--color-text-muted', '#4a5560');
    const monoFont = readVar('--font-mono', 'ui-monospace, monospace');
    const pointColor = readVar('--color-accent', '#004c97');

    const points: Point[] = raw.points.map((p) => ({ ...p, px: 0, py: 0 }));

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    const pad = 40;

    function layout() {
      const xs = points.map((p) => p.x);
      const ys = points.map((p) => p.y);
      const minX = Math.min(...xs);
      const maxX = Math.max(...xs);
      const minY = Math.min(...ys);
      const maxY = Math.max(...ys);
      const rangeX = Math.max(maxX - minX, 0.001);
      const rangeY = Math.max(maxY - minY, 0.001);
      for (const p of points) {
        p.px = pad + ((p.x - minX) / rangeX) * (width - pad * 2);
        p.py = height - pad - ((p.y - minY) / rangeY) * (height - pad * 2);
      }
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      layout();
    }

    let hovered: Point | null = null;

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      ctx!.strokeStyle = gridColor;
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      ctx!.moveTo(pad, height / 2);
      ctx!.lineTo(width - pad, height / 2);
      ctx!.moveTo(width / 2, pad);
      ctx!.lineTo(width / 2, height - pad);
      ctx!.stroke();
      ctx!.strokeStyle = axisColor;
      ctx!.strokeRect(pad, pad, width - pad * 2, height - pad * 2);

      ctx!.font = `11px ${monoFont}`;
      ctx!.fillStyle = textColor;
      ctx!.textAlign = 'center';
      ctx!.fillText(`PC1 (${raw.pc1Pct}%)`, width / 2, height - pad + 22);
      ctx!.save();
      ctx!.translate(pad - 24, height / 2);
      ctx!.rotate(-Math.PI / 2);
      ctx!.fillText(`PC2 (${raw.pc2Pct}%)`, 0, 0);
      ctx!.restore();

      // soft outline around the whole cluster, drawn first so points sit on top
      if (points.length >= 3) {
        const hull = inflateHull(convexHull(points), 26);
        ctx!.beginPath();
        smoothClosedPath(ctx!, hull);
        ctx!.closePath();
        ctx!.fillStyle = pointColor;
        ctx!.globalAlpha = 0.06;
        ctx!.fill();
        ctx!.globalAlpha = 0.3;
        ctx!.strokeStyle = pointColor;
        ctx!.lineWidth = 1.5;
        ctx!.setLineDash([4, 4]);
        ctx!.stroke();
        ctx!.setLineDash([]);
      }
      ctx!.globalAlpha = 1;

      for (const p of points) {
        const isHot = p === hovered;
        ctx!.beginPath();
        ctx!.fillStyle = pointColor;
        ctx!.globalAlpha = isHot ? 1 : 0.82;
        ctx!.arc(p.px, p.py, isHot ? 8 : 6, 0, Math.PI * 2);
        ctx!.fill();
        if (isHot) {
          ctx!.lineWidth = 2;
          ctx!.strokeStyle = readVar('--color-text', '#14181d');
          ctx!.stroke();
        }
      }
      ctx!.globalAlpha = 1;
    }

    function pointAt(x: number, y: number): Point | null {
      let best: Point | null = null;
      let bestDist = 14;
      for (const p of points) {
        const d = Math.hypot(p.px - x, p.py - y);
        if (d < bestDist) {
          bestDist = d;
          best = p;
        }
      }
      return best;
    }

    function pointerPos(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    canvas.addEventListener('pointermove', (e) => {
      const pos = pointerPos(e);
      const hit = pointAt(pos.x, pos.y);
      hovered = hit;
      canvas!.style.cursor = hit ? 'pointer' : 'default';
      if (hit && tooltip) {
        tooltip.hidden = false;
        tooltip.style.left = `${hit.px}px`;
        tooltip.style.top = `${hit.py}px`;
        tooltip.innerHTML = `<strong>${hit.title}</strong>${hit.journal}, ${hit.year}`;
      } else if (tooltip) {
        tooltip.hidden = true;
      }
      draw();
    });
    canvas.addEventListener('pointerleave', () => {
      hovered = null;
      if (tooltip) tooltip.hidden = true;
      draw();
    });
    canvas.addEventListener('click', (e) => {
      const pos = pointerPos(e);
      const hit = pointAt(pos.x, pos.y);
      if (!hit) return;
      const card = document.querySelector<HTMLElement>(`[data-pub-id="${hit.id}"]`);
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('pub-card--flash');
        setTimeout(() => card.classList.remove('pub-card--flash'), 1500);
      }
    });

    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => {
        resize();
        draw();
      });
      ro.observe(canvas);
    } else {
      window.addEventListener('resize', () => {
        resize();
        draw();
      });
    }

    resize();
    draw();
  }
</script>
