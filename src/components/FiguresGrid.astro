---
// A grayscale-by-default, color-on-hover grid of real figures — the two
// research-program diagrams (also used full-size on the Research page)
// plus any publication with an `image` set. Home-only: gives the page
// real, non-decorative content instead of a single sparse tile. A CSS
// multi-column ("masonry") layout, not a uniform grid — these images are
// genuinely different shapes (near-square diagram, portrait diagram, tall
// multi-panel figure), and forcing them into equal boxes with
// object-fit: contain just padded them with white space.
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  eyebrow?: string;
  class?: string;
}

const { eyebrow = 'Selected figures', class: className } = Astro.props;

const publications = await getCollection('publications');
const pubFigures = publications
  .filter((p) => p.data.image)
  .sort((a, b) => b.data.year - a.data.year)
  .map((pub) => ({
    title: pub.data.title,
    meta: `${pub.data.journal} · ${pub.data.year}`,
    image: pub.data.image!,
    imageAlt: pub.data.imageAlt ?? '',
    href: pub.data.doi ?? pub.data.url,
    external: true,
  }));

// Same two diagrams shown full-size on /research — duplicated here in
// miniature (matching the existing nav-items duplication pattern between
// SiteHeader and SearchPalette) rather than pulling in that page's whole
// text-heavy `processes` array.
const researchFigures = [
  {
    title: 'Retinal Diseasome Assembly',
    meta: 'Research · multi-omic QTL framework',
    image: '/images/epigenetic-qtl-diagram.jpg',
    imageAlt:
      'Diagram of quantitative trait loci linking genotype to DNA methylation, histone modification, and gene expression',
    href: '/research',
    external: false,
  },
  {
    title: 'Environmental–Molecular Interactions in Retinal Aging',
    meta: 'Research · aging mouse model',
    image: '/images/retinal-aging-diagram.jpg',
    imageAlt: 'Diagram of visual function decline with age across genetic, structural, and functional factors',
    href: '/research',
    external: false,
  },
];

const figured = [...researchFigures, ...pubFigures];
---

{
  figured.length > 0 && (
    <div class:list={['figures-grid-wrap', className]}>
      <span class="eyebrow">{eyebrow}</span>
      <div class="figures-grid">
        {figured.map((fig) => (
          <a
            class="figure-tile"
            href={fig.external ? fig.href : withBase(fig.href)}
            target={fig.external ? '_blank' : undefined}
            rel={fig.external ? 'noopener noreferrer' : undefined}
          >
            <img src={withBase(fig.image)} alt={fig.imageAlt} loading="lazy" />
            <span class="figure-tile__overlay">
              <span class="figure-tile__title">{fig.title}</span>
              <span class="mono figure-tile__meta">{fig.meta}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .figures-grid {
    /* A fixed column-count (not column-width) so the columns stretch to
       fill the full row edge-to-edge — a real masonry block, not a few
       small tiles stranded on the left with empty space to their right.
       Each column is still narrower than the old 2-up split, and every
       image keeps its own natural aspect ratio, so column heights vary. */
    column-count: 3;
    column-gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .figure-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
    break-inside: avoid;
    margin-bottom: var(--space-3);
  }

  .figure-tile img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1);
    transition: filter 0.3s var(--ease-out);
  }

  .figure-tile:hover img,
  .figure-tile:focus-visible img {
    filter: grayscale(0);
  }

  .figure-tile__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3em;
    padding: var(--space-3);
    background: linear-gradient(to top, rgba(10, 10, 10, 0.9), rgba(10, 10, 10, 0) 60%);
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }

  .figure-tile:hover .figure-tile__overlay,
  .figure-tile:focus-visible .figure-tile__overlay {
    opacity: 1;
  }

  .figure-tile__title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .figure-tile__meta {
    font-size: var(--text-xs);
    color: #d4d4d6;
  }

  @media (max-width: 900px) {
    .figures-grid {
      column-count: 2;
    }
  }

  @media (max-width: 640px) {
    .figures-grid {
      column-count: 1;
    }
  }
</style>
