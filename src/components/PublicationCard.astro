---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  id: string;
  publication: CollectionEntry<'publications'>['data'];
}

const { id, publication: pub } = Astro.props;
const link = pub.doi ?? pub.url;

const metaParts: string[] = [];
if (pub.volume) {
  metaParts.push(pub.issue ? `${pub.volume}(${pub.issue})` : pub.volume);
}
if (pub.pages) metaParts.push(pub.pages);
if (pub.articleNumber) metaParts.push(`Art. ${pub.articleNumber}`);
---

<article
  class="pub-card"
  data-pub-card
  data-pub-id={id}
  data-keywords={pub.keywords.join('|')}
  data-year={pub.year}
  data-citations={pub.citations ?? 0}
  itemscope
  itemtype="https://schema.org/ScholarlyArticle"
>
  {pub.image && (
    <img
      class="pub-card__figure"
      src={withBase(pub.image)}
      alt={pub.imageAlt ?? ''}
      loading="lazy"
    />
  )}

  <div class="pub-card__top">
    <span class="mono pub-card__year">{pub.year}</span>
    {pub.featured && <span class="pub-card__badge">Featured</span>}
    {pub.citations !== undefined && (
      <span class="mono pub-card__citations">{pub.citations} citations</span>
    )}
  </div>

  <p class="pub-card__title" itemprop="name">
    {link ? (
      <a href={link} target="_blank" rel="noopener noreferrer">
        {pub.title}
      </a>
    ) : (
      pub.title
    )}
  </p>

  <p class="pub-card__authors">
    {pub.authors.map((author, i) => (
      <>
        {i > 0 && ', '}
        {author === pub.piHighlight ? <strong>{author}</strong> : author}
      </>
    ))}
  </p>

  <p class="mono pub-card__meta">
    <cite itemprop="isPartOf">{pub.journal}</cite>
    {pub.month && `, ${pub.month} ${pub.year}`}
    {!pub.month && `, ${pub.year}`}
    {metaParts.length > 0 && `, ${metaParts.join(':')}`}
  </p>

  {pub.summary && (
    <p class="pub-card__summary" itemprop="description">
      {pub.summary}
    </p>
  )}

  {link && (
    <a class="mono pub-card__link" href={link} target="_blank" rel="noopener noreferrer">
      Read the paper →
    </a>
  )}

  {pub.keywords.length > 0 && (
    <ul class="pub-card__tags">
      {pub.keywords.map((kw) => (
        <li class="mono" data-keyword-tag={kw}>{kw}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .pub-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    transition: opacity 0.2s var(--ease-out), background 0.15s var(--ease-out);
  }

  .pub-card + .pub-card {
    border-top: none;
  }

  .pub-card:hover {
    background: var(--color-bg-inset);
  }

  .pub-card--flash {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .pub-card[data-dimmed='true'] {
    opacity: 0.35;
  }

  .pub-card__figure {
    width: 100%;
    max-height: 22rem;
    object-fit: contain;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-3);
  }

  .pub-card__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .pub-card__year {
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .pub-card__badge {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.1em 0.5em;
  }

  .pub-card__citations {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .pub-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    margin-bottom: 0.5em;
  }

  .pub-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .pub-card__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .pub-card__authors {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .pub-card__meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .pub-card__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    margin-bottom: var(--space-2);
  }

  .pub-card__link {
    display: inline-block;
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-decoration: none;
    margin-bottom: var(--space-2);
  }

  .pub-card__link:hover {
    text-decoration: underline;
  }

  .pub-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .pub-card__tags li {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.15em 0.55em;
  }
</style>
